\pard\ql\fs20 from django.db import models\par
from django.db.models import Sum\par
from django.contrib.auth.models import AbstractUser\par
from django.utils import timezone\par
\par
class Role(models.Model):\par
    name = models.CharField(max_length=64, unique=True)\par
\par
    class Meta:\par
        verbose_name = 'Роль'\par
        verbose_name_plural = 'Роли'\par
\par
    def __str__(self):\par
        return self.name\par
\par
class User(AbstractUser):\par
    email = models.EmailField('Email', unique=True)\par
    full_name = models.CharField('ФИО', max_length=255)\par
    phone = models.CharField('Телефон', max_length=32, blank=True)\par
    roles = models.ManyToManyField(Role, through='UserRole', related_name='users', blank=True)\par
\par
    REQUIRED_FIELDS = ['full_name', 'email']\par
\par
    class Meta:\par
        verbose_name = 'Пользователь'\par
        verbose_name_plural = 'Пользователи'\par
\par
    def __str__(self):\par
        return self.full_name or self.username\par
\par
class ClientType(models.TextChoices):\par
    STORE = 'store', 'Магазин'\par
    CAFE = 'cafe', 'Кафе'\par
    RESTAURANT = 'restaurant', 'Ресторан'\par
    DISTRIBUTOR = 'distributor', 'Дистрибьютор'\par
    OTHER = 'other', 'Другое'\par
\par
class ClientStatus(models.TextChoices):\par
    PROSPECT = 'prospect', 'Переговоры'\par
    ACTIVE = 'active', 'Активен'\par
    PAUSED = 'paused', 'Приостановлен'\par
    LOST = 'lost', 'Закрыт'\par
\par
class Client(models.Model):\par
    name = models.CharField('Название', max_length=255)\par
    client_type = models.CharField('Тип', max_length=32, choices=ClientType.choices, default=ClientType.STORE)\par
    inn = models.CharField('ИНН', max_length=20, blank=True)\par
    kpp = models.CharField('КПП', max_length=20, blank=True)\par
    default_delivery_address = models.CharField('Адрес доставки по умолчанию', max_length=255, blank=True)\par
    email = models.EmailField('Email', blank=True)\par
    phone = models.CharField('Телефон', max_length=32, blank=True)\par
    status = models.CharField('Статус', max_length=20, choices=ClientStatus.choices, default=ClientStatus.PROSPECT)\par
    current_stage = models.ForeignKey("CooperationStage", on_delete=models.SET_NULL, null=True, blank=True, related_name="clients")\par
    responsible_manager = models.ForeignKey(User, on_delete=models.SET_NULL, null=True, blank=True, related_name='clients')\par
    created_at = models.DateTimeField('Создан', auto_now_add=True, null=True, blank=True)\par
    daily_max_weight_kg = models.DecimalField('Макс. вес в день (кг)', max_digits=10, decimal_places=2, null=True, blank=True)\par
    daily_min_qty = models.DecimalField('Мин. объём заказа', max_digits=10, decimal_places=2, null=True, blank=True)\par
    guaranteed_volume_kg = models.DecimalField('Гарантированный объём (кг)', max_digits=10, decimal_places=2, null=True, blank=True)\par
\par
    class Meta:\par
        verbose_name = 'Клиент'\par
        verbose_name_plural = 'Клиенты'\par
\par
    def __str__(self):\par
        return self.name\par
\par
class CooperationStage(models.Model):\par
    name = models.CharField('Название этапа', max_length=128)\par
    order = models.PositiveSmallIntegerField('Порядок', default=1)\par
    is_active = models.BooleanField('Активен', default=True)\par
\par
    class Meta:\par
        ordering = ['order']\par
        verbose_name = 'Этап сотрудничества'\par
        verbose_name_plural = 'Этапы сотрудничества'\par
\par
    def __str__(self):\par
        return self.name\par
\par
class Interaction(models.Model):\par
    client = models.ForeignKey(Client, on_delete=models.CASCADE, related_name='interactions')\par
    manager = models.ForeignKey(User, on_delete=models.SET_NULL, null=True, related_name='interactions')\par
    interaction_type = models.CharField('Тип', max_length=20, choices=[('call', 'Звонок'), ('meeting', 'Встреча'), ('email', 'Email')])\par
    note = models.TextField('Заметка', blank=True)\par
    happened_at = models.DateTimeField('Дата/время', default=timezone.now)\par
\par
class Order(models.Model):\par
    order_number = models.CharField('Номер заказа', max_length=50, unique=True)\par
    client = models.ForeignKey(Client, on_delete=models.CASCADE, related_name='orders')\par
    manager = models.ForeignKey(User, on_delete=models.SET_NULL, null=True, blank=True, related_name='orders')\par
    address = models.CharField('Адрес доставки', max_length=255, blank=True)\par
    status = models.CharField('Статус', max_length=64, choices=OrderStatus.choices, default=OrderStatus.DRAFT)\par
    delivery_date = models.DateField('Дата доставки', null=True, blank=True)\par
    delivery_time = models.TimeField('Время доставки', null=True, blank=True)\par
    delivery_type = models.CharField('Тип доставки', max_length=32, choices=[('Регулярная', 'Регулярная'), ('Разовая', 'Разовая'), ('Срочная', 'Срочная')], default='Разовая')\par
    production_date = models.DateField('Дата производства', null=True, blank=True)\par
    production_shift = models.CharField('Смена', max_length=32, blank=True)\par
    production_window_start = models.TimeField('Окно производства (с)', null=True, blank=True)\par
    production_window_end = models.TimeField('Окно производства (до)', null=True, blank=True)\par
    comments = models.TextField('Комментарии', blank=True)\par
    total_amount = models.DecimalField('Сумма итого', max_digits=12, decimal_places=2, default=0)\par
    is_archived = models.BooleanField('В архиве', default=False)\par
    created_at = models.DateTimeField(auto_now_add=True)\par
    updated_at = models.DateTimeField(auto_now=True)\par
\par
    @classmethod\par
    def generate_order_number(cls):\par
        date_part = timezone.now().strftime("%Y%m%d")\par
        base = f"ORD-\{date_part\}-"\par
        last = cls.objects.filter(order_number__startswith=base).order_by("-order_number").first()\par
        seq = 1\par
        if last and last.order_number.split("-")[-1].isdigit():\par
            seq = int(last.order_number.split("-")[-1]) + 1\par
        return f"\{base\}\{seq:03d\}"\par
\par
    def recalc_total(self):\par
        total = self.items.aggregate(total=Sum("line_total"))["total"] or 0\par
        if self.total_amount != total:\par
            self.total_amount = total\par
            self.save(update_fields=["total_amount"])\par
\par
class Delivery(models.Model):\par
    order = models.ForeignKey(Order, on_delete=models.CASCADE, related_name='deliveries')\par
    courier = models.ForeignKey(Courier, on_delete=models.SET_NULL, null=True, blank=True, related_name='deliveries')\par
    route = models.ForeignKey("Route", on_delete=models.SET_NULL, null=True, blank=True, related_name='deliveries')\par
    status = models.CharField('Статус', max_length=20, choices=DeliveryStatus.choices, default=DeliveryStatus.UNASSIGNED)\par
    planned_at = models.DateTimeField('Плановая дата/время', null=True, blank=True)\par
    departure_time = models.DateTimeField('Время выезда', null=True, blank=True)\par
    delivered_at = models.DateTimeField('Доставлено', null=True, blank=True)\par
    delivery_date = models.DateField('Дата доставки', null=True, blank=True)\par
    address = models.CharField('Адрес', max_length=255, blank=True)\par
    note = models.TextField('Примечание', blank=True)\par
    is_sent = models.BooleanField('Отправлен', default=False)\par
\par
    def save(self, *args, **kwargs):\par
        if self.planned_at and not self.delivery_date:\par
            self.delivery_date = self.planned_at.date()\par
        super().save(*args, **kwargs)\par
\par
class Route(models.Model):\par
    logistician = models.ForeignKey(User, on_delete=models.SET_NULL, null=True, blank=True, related_name='routes')\par
    planned_date = models.DateField('Дата маршрута')\par
    status = models.CharField('Статус', max_length=20, choices=RouteStatus.choices, default=RouteStatus.DRAFT)\par
    max_duration_minutes = models.PositiveSmallIntegerField('Макс. длительность (мин)', default=720)\par
    soft_limit_stops = models.PositiveSmallIntegerField('Мягкий лимит точек', default=30)\par
    strict_mode = models.BooleanField('Строгий режим лимита точек', default=False)\par
    notes = models.TextField('Заметки', blank=True)\par
\par
class RouteStop(models.Model):\par
    route = models.ForeignKey(Route, on_delete=models.CASCADE, related_name='stops')\par
    delivery = models.ForeignKey(Delivery, on_delete=models.CASCADE, related_name='route_stops')\par
    sequence_index = models.PositiveSmallIntegerField('Порядок', default=1)\par
    planned_time = models.DateTimeField('Плановое время', null=True, blank=True)\par
    actual_time = models.DateTimeField('Фактическое время', null=True, blank=True)\par
    service_time_minutes = models.PositiveSmallIntegerField('Время обслуживания (мин)', default=15)\par
    note = models.CharField('Примечание', max_length=255, blank=True)\par
    status = models.CharField('Статус', max_length=20, choices=StopStatus.choices, default=StopStatus.DRAFT)\par
    delivery_date = models.DateField('Дата доставки', null=True, blank=True)\par
    failure_reason = models.TextField('Причина недоставки', blank=True)\par
    proof_of_delivery = models.FileField('Документ доставки', upload_to='delivery_proofs/', null=True, blank=True)\par
