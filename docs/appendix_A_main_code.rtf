\pard\ql\fs20 from django.shortcuts import render, redirect, get_object_or_404\par
from django.db.models import Q\par
from django.contrib import messages\par
from accounts.utils import roles_required\par
from crm.models import Client, CooperationStage, ClientStageHistory, Interaction, ClientStatus, Order\par
from .forms import ClientForm, InteractionForm, StageChangeForm\par
\par
@roles_required(["Менеджер", "Администратор системы"])\par
def client_list(request):\par
    qs = Client.objects.select_related("current_stage", "responsible_manager").all()\par
    q = request.GET.get("q")\par
    status = request.GET.get("status")\par
    stage = request.GET.get("stage")\par
    sort = request.GET.get("sort")\par
    if q:\par
        qs = qs.filter(Q(name__icontains=q) | Q(phone__icontains=q) | Q(email__icontains=q))\par
    if status:\par
        qs = qs.filter(status=status)\par
    if stage:\par
        qs = qs.filter(current_stage_id=stage)\par
    if sort in ["name", "-name", "created_at", "-created_at"]:\par
        qs = qs.order_by(sort)\par
    stages = CooperationStage.objects.filter(is_active=True)\par
    return render(\par
        request,\par
        "clients/list.html",\par
        \{"clients": qs, "stages": stages, "status_choices": ClientStatus.choices\},\par
    )\par
\par
@roles_required(["Менеджер", "Администратор системы"])\par
def client_create(request):\par
    form = ClientForm(request.POST or None)\par
    if request.method == "POST" and form.is_valid():\par
        obj = form.save(commit=False)\par
        if request.user.roles.filter(name__iexact="Менеджер").exists():\par
            obj.responsible_manager = request.user\par
        obj.save()\par
        form.save_m2m()\par
        messages.success(request, "Клиент создан.")\par
        return redirect("/clients/")\par
    return render(request, "clients/form.html", \{"form": form, "title": "Новый клиент"\})\par
\par
@roles_required(["Менеджер", "Администратор системы"])\par
def client_edit(request, pk):\par
    obj = get_object_or_404(Client, pk=pk)\par
    form = ClientForm(request.POST or None, instance=obj)\par
    if request.method == "POST" and form.is_valid():\par
        form.save()\par
        messages.success(request, "Клиент обновлён.")\par
        return redirect("/clients/")\par
    return render(request, "clients/form.html", \{"form": form, "title": "Редактирование клиента"\})\par
\par
@roles_required(["Менеджер", "Администратор системы"])\par
def client_delete(request, pk):\par
    obj = get_object_or_404(Client, pk=pk)\par
    if request.method == "POST":\par
        obj.delete()\par
        messages.success(request, "Клиент удалён.")\par
        return redirect("/clients/")\par
    return render(request, "clients/delete.html", \{"object": obj\})\par
\par
@roles_required(["Менеджер", "Администратор системы"])\par
def client_detail(request, pk):\par
    client = get_object_or_404(Client, pk=pk)\par
    interactions = Interaction.objects.filter(client=client).select_related("manager")\par
    stage_history = ClientStageHistory.objects.filter(client=client).select_related("stage", "changed_by")\par
    client_orders = Order.objects.filter(client=client).order_by("-created_at")\par
\par
    interaction_form = InteractionForm(prefix="interaction")\par
    stage_form = StageChangeForm(prefix="stage", initial=\{"stage": client.current_stage\})\par
\par
    if request.method == "POST":\par
        action = request.POST.get("action")\par
        if action == "add_interaction":\par
            interaction_form = InteractionForm(request.POST, prefix="interaction")\par
            if interaction_form.is_valid():\par
                obj = interaction_form.save(commit=False)\par
                obj.client = client\par
                obj.manager = request.user\par
                obj.save()\par
                messages.success(request, "Взаимодействие добавлено.")\par
                return redirect(f"/clients/\{client.id\}/")\par
        if action == "change_stage":\par
            stage_form = StageChangeForm(request.POST, prefix="stage")\par
            if stage_form.is_valid():\par
                stage = stage_form.cleaned_data["stage"]\par
                comment = stage_form.cleaned_data.get("comment", "")\par
                ClientStageHistory.objects.create(\par
                    client=client,\par
                    stage=stage,\par
                    changed_by=request.user,\par
                    comment=comment,\par
                )\par
                client.current_stage = stage\par
                client.save(update_fields=["current_stage"])\par
                messages.success(request, "Этап сотрудничества обновлён.")\par
                return redirect(f"/clients/\{client.id\}/")\par
\par
    return render(\par
        request,\par
        "clients/detail.html",\par
        \{\par
            "client": client,\par
            "interactions": interactions,\par
            "stage_history": stage_history,\par
            "client_orders": client_orders,\par
            "interaction_form": interaction_form,\par
            "stage_form": stage_form,\par
        \},\par
    )\par
\par
