    line_total = models.DecimalField('\u1057?\u1091?\u1084?\u1084?\u1072?', max_digits=12, decimal_places=2, editable=False, default=0)\par
    supply_type = models.CharField('\u1058?\u1080?\u1087? \u1087?\u1086?\u1089?\u1090?\u1072?\u1074?\u1082?\u1080?/\u1079?\u1072?\u1103?\u1074?\u1082?\u1080?', max_length=64, blank=True)\par
    picked_quantity = models.DecimalField('\u1057?\u1086?\u1073?\u1088?\u1072?\u1085?\u1086? \u1092?\u1072?\u1082?\u1090?\u1080?\u1095?\u1077?\u1089?\u1082?\u1080?', max_digits=10, decimal_places=3, default=0)\par
    item_status = models.CharField('\u1057?\u1090?\u1072?\u1090?\u1091?\u1089? \u1087?\u1086?\u1079?\u1080?\u1094?\u1080?\u1080?', max_length=20, choices=ItemStatus.choices, default=ItemStatus.NOT_STARTED)\par
    item_comment = models.CharField('\u1050?\u1086?\u1084?\u1084?\u1077?\u1085?\u1090?\u1072?\u1088?\u1080?\u1081? \u1087?\u1086? \u1087?\u1086?\u1079?\u1080?\u1094?\u1080?\u1080?', max_length=255, blank=True)\par
    replacement_text = models.CharField('\u1047?\u1072?\u1084?\u1077?\u1085?\u1072?', max_length=255, blank=True)\par
\par
    class Meta:\par
        verbose_name = '\u1055?\u1086?\u1079?\u1080?\u1094?\u1080?\u1103? \u1079?\u1072?\u1082?\u1072?\u1079?\u1072?'\par
        verbose_name_plural = '\u1055?\u1086?\u1079?\u1080?\u1094?\u1080?\u1080? \u1079?\u1072?\u1082?\u1072?\u1079?\u1072?'\par
\par
    def save(self, *args, **kwargs):\par
        self.line_total = (self.quantity or 0) * (self.unit_price or 0)\par
        super().save(*args, **kwargs)\par
        if self.order_id:\par
            self.order.recalc_total()\par
\par
    def delete(self, *args, **kwargs):\par
        order = self.order\par
        super().delete(*args, **kwargs)\par
        if order:\par
            order.recalc_total()\par
\par
    def display_name(self):\par
        if self.dish:\par
            return self.dish.name\par
        if self.ingredient:\par
            return self.ingredient.name\par
        if self.custom_tech_card:\par
            return str(self.custom_tech_card)\par
        return "\u1055?\u1086?\u1079?\u1080?\u1094?\u1080?\u1103?"\par
\par
    def __str__(self):\par
        subject = self.dish or self.ingredient or self.custom_tech_card or '\u1055?\u1086?\u1079?\u1080?\u1094?\u1080?\u1103?'\par
        return f"\{subject\} x \{self.quantity\}"\par
\par
