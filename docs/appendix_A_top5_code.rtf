from django.db import models\par
from django.db.models import Sum\par
from django.contrib.auth.models import AbstractUser\par
from django.utils import timezone\par
\par
\par
class Role(models.Model):\par
    name = models.CharField(max_length=64, unique=True)\par
\par
    class Meta:\par
        verbose_name = '\u1056?\u1086?\u1083?\u1100?'\par
        verbose_name_plural = '\u1056?\u1086?\u1083?\u1080?'\par
\par
    def __str__(self):\par
        return self.name\par
\par
\par
class User(AbstractUser):\par
    email = models.EmailField('Email', unique=True)\par
    full_name = models.CharField('\u1060?\u1048?\u1054?', max_length=255)\par
    phone = models.CharField('\u1058?\u1077?\u1083?\u1077?\u1092?\u1086?\u1085?', max_length=32, blank=True)\par
    roles = models.ManyToManyField(Role, through='UserRole', related_name='users', blank=True)\par
\par
    REQUIRED_FIELDS = ['full_name', 'email']\par
\par
    class Meta:\par
        verbose_name = '\u1055?\u1086?\u1083?\u1100?\u1079?\u1086?\u1074?\u1072?\u1090?\u1077?\u1083?\u1100?'\par
        verbose_name_plural = '\u1055?\u1086?\u1083?\u1100?\u1079?\u1086?\u1074?\u1072?\u1090?\u1077?\u1083?\u1080?'\par
\par
    def __str__(self):\par
        return self.full_name or self.username\par
\par
\par
class UserRole(models.Model):\par
    user = models.ForeignKey(User, on_delete=models.CASCADE)\par
    role = models.ForeignKey(Role, on_delete=models.CASCADE)\par
    assigned_at = models.DateTimeField(default=timezone.now)\par
\par
    class Meta:\par
        unique_together = ('user', 'role')\par
        verbose_name = '\u1056?\u1086?\u1083?\u1100? \u1087?\u1086?\u1083?\u1100?\u1079?\u1086?\u1074?\u1072?\u1090?\u1077?\u1083?\u1103?'\par
        verbose_name_plural = '\u1056?\u1086?\u1083?\u1080? \u1087?\u1086?\u1083?\u1100?\u1079?\u1086?\u1074?\u1072?\u1090?\u1077?\u1083?\u1077?\u1081?'\par
\par
    def __str__(self):\par
        return f"\{self.user\} \u8594? \{self.role\}"\par
\par
