    def save(self, *args, **kwargs):\par
        if self.route_id and (self.sequence_index is None or self.sequence_index <= 0):\par
            last = RouteStop.objects.filter(route_id=self.route_id).order_by("-sequence_index").first()\par
            self.sequence_index = (last.sequence_index + 1) if last else 1\par
        if self.delivery_id and not self.delivery_date:\par
            if self.delivery.delivery_date:\par
                self.delivery_date = self.delivery.delivery_date\par
            elif self.delivery.planned_at:\par
                self.delivery_date = self.delivery.planned_at.date()\par
