from django.shortcuts import render, redirect, get_object_or_404\par
from django.db.models import Q\par
from django.contrib import messages\par
from accounts.utils import roles_required\par
from crm.models import Client, CooperationStage, ClientStageHistory, Interaction, ClientStatus, Order\par
from .forms import ClientForm, InteractionForm, StageChangeForm\par
\par
\par
@roles_required(["\u1052?\u1077?\u1085?\u1077?\u1076?\u1078?\u1077?\u1088?", "\u1040?\u1076?\u1084?\u1080?\u1085?\u1080?\u1089?\u1090?\u1088?\u1072?\u1090?\u1086?\u1088? \u1089?\u1080?\u1089?\u1090?\u1077?\u1084?\u1099?"])\par
def client_list(request):\par
    qs = Client.objects.select_related("current_stage", "responsible_manager").all()\par
    q = request.GET.get("q")\par
    status = request.GET.get("status")\par
    stage = request.GET.get("stage")\par
    sort = request.GET.get("sort")\par
    if q:\par
        qs = qs.filter(Q(name__icontains=q) | Q(phone__icontains=q) | Q(email__icontains=q))\par
    if status:\par
        qs = qs.filter(status=status)\par
    if stage:\par
        qs = qs.filter(current_stage_id=stage)\par
    if sort in ["name", "-name", "created_at", "-created_at"]:\par
        qs = qs.order_by(sort)\par
    stages = CooperationStage.objects.filter(is_active=True)\par
    return render(\par
        request,\par
        "clients/list.html",\par
        \{"clients": qs, "stages": stages, "status_choices": ClientStatus.choices\},\par
    )\par
\par
\par
@roles_required(["\u1052?\u1077?\u1085?\u1077?\u1076?\u1078?\u1077?\u1088?", "\u1040?\u1076?\u1084?\u1080?\u1085?\u1080?\u1089?\u1090?\u1088?\u1072?\u1090?\u1086?\u1088? \u1089?\u1080?\u1089?\u1090?\u1077?\u1084?\u1099?"])\par
def client_create(request):\par
    form = ClientForm(request.POST or None)\par
    if request.method == "POST" and form.is_valid():\par
        obj = form.save(commit=False)\par
        if request.user.roles.filter(name__iexact="\u1052?\u1077?\u1085?\u1077?\u1076?\u1078?\u1077?\u1088?").exists():\par
            obj.responsible_manager = request.user\par
        obj.save()\par
        form.save_m2m()\par
        messages.success(request, "\u1050?\u1083?\u1080?\u1077?\u1085?\u1090? \u1089?\u1086?\u1079?\u1076?\u1072?\u1085?.")\par
        return redirect("/clients/")\par
    return render(request, "clients/form.html", \{"form": form, "title": "\u1053?\u1086?\u1074?\u1099?\u1081? \u1082?\u1083?\u1080?\u1077?\u1085?\u1090?"\})\par
\par
\par
@roles_required(["\u1052?\u1077?\u1085?\u1077?\u1076?\u1078?\u1077?\u1088?", "\u1040?\u1076?\u1084?\u1080?\u1085?\u1080?\u1089?\u1090?\u1088?\u1072?\u1090?\u1086?\u1088? \u1089?\u1080?\u1089?\u1090?\u1077?\u1084?\u1099?"])\par
def client_edit(request, pk):\par
    obj = get_object_or_404(Client, pk=pk)\par
    form = ClientForm(request.POST or None, instance=obj)\par
    if request.method == "POST" and form.is_valid():\par
        form.save()\par
        messages.success(request, "\u1050?\u1083?\u1080?\u1077?\u1085?\u1090? \u1086?\u1073?\u1085?\u1086?\u1074?\u1083?\u1105?\u1085?.")\par
        return redirect("/clients/")\par
    return render(request, "clients/form.html", \{"form": form, "title": "\u1056?\u1077?\u1076?\u1072?\u1082?\u1090?\u1080?\u1088?\u1086?\u1074?\u1072?\u1085?\u1080?\u1077? \u1082?\u1083?\u1080?\u1077?\u1085?\u1090?\u1072?"\})\par
\par
