def _validate_order_capacity(order, items):\par
    errors = []\par
    warnings = []\par
    info = \{\}\par
\par
    if order.delivery_date:\par
        cutoff = timezone.datetime.strptime(getattr(settings, "ORDER_CUTOFF_TIME", "16:00"), "%H:%M").time()\par
        if order.delivery_date == timezone.now().date() and timezone.now().time() > cutoff:\par
            errors.append("\u1047?\u1072?\u1082?\u1072?\u1079? \u1087?\u1086?\u1089?\u1083?\u1077? \u1076?\u1086?\u1087?\u1091?\u1089?\u1090?\u1080?\u1084?\u1086?\u1075?\u1086? \u1074?\u1088?\u1077?\u1084?\u1077?\u1085?\u1080?. \u1055?\u1077?\u1088?\u1077?\u1085?\u1077?\u1089?\u1080?\u1090?\u1077? \u1076?\u1072?\u1090?\u1091? \u1076?\u1086?\u1089?\u1090?\u1072?\u1074?\u1082?\u1080?.")\par
\par
    total_weight = sum([_order_item_weight(i) for i in items])\par
    info["order_weight"] = total_weight\par
    if order.client.daily_max_weight_kg and order.delivery_date:\par
        existing = Order.objects.filter(client=order.client, delivery_date=order.delivery_date).exclude(pk=order.pk)\par
        existing_weight = sum([sum([_order_item_weight(i) for i in o.items.all()]) for o in existing])\par
        info["client_daily_limit"] = order.client.daily_max_weight_kg\par
        info["client_reserved"] = existing_weight\par
        if existing_weight + total_weight > order.client.daily_max_weight_kg:\par
            errors.append("\u1055?\u1088?\u1077?\u1074?\u1099?\u1096?\u1077?\u1085? \u1083?\u1080?\u1084?\u1080?\u1090? \u1082?\u1083?\u1080?\u1077?\u1085?\u1090?\u1072? \u1087?\u1086? \u1074?\u1077?\u1089?\u1091? \u1085?\u1072? \u1076?\u1077?\u1085?\u1100?.")\par
    if order.client.daily_min_qty and total_weight < order.client.daily_min_qty:\par
        warnings.append("\u1052?\u1080?\u1085?\u1080?\u1084?\u1072?\u1083?\u1100?\u1085?\u1099?\u1081? \u1086?\u1073?\u1098?\u1105?\u1084? \u1082?\u1083?\u1080?\u1077?\u1085?\u1090?\u1072? \u1085?\u1077? \u1076?\u1086?\u1089?\u1090?\u1080?\u1075?\u1085?\u1091?\u1090?.")\par
\par
    max_capacity = getattr(settings, "PRODUCTION_MAX_WEIGHT_KG", None)\par
    if max_capacity is not None and order.production_date:\par
        reserved = ProductionReservation.objects.filter(production_date=order.production_date).exclude(order=order).aggregate(\par
            total=Sum("weight_kg")\par
        )["total"] or 0\par
        info["production_capacity"] = max_capacity\par
        info["production_reserved"] = reserved\par
        if reserved + total_weight > max_capacity:\par
            excess = (reserved + total_weight) - max_capacity\par
            errors.append(\par
                f"\u1055?\u1088?\u1077?\u1074?\u1099?\u1096?\u1077?\u1085?\u1072? \u1087?\u1088?\u1086?\u1080?\u1079?\u1074?\u1086?\u1076?\u1089?\u1090?\u1074?\u1077?\u1085?\u1085?\u1072?\u1103? \u1084?\u1086?\u1097?\u1085?\u1086?\u1089?\u1090?\u1100? \u1085?\u1072? \{order.production_date\}. "\par
                f"\u1044?\u1086?\u1089?\u1090?\u1091?\u1087?\u1085?\u1086?: \{max_capacity\} \u1082?\u1075?, \u1074?\u1072?\u1096? \u1079?\u1072?\u1082?\u1072?\u1079?: \{total_weight\} \u1082?\u1075?, \u1087?\u1088?\u1077?\u1074?\u1099?\u1096?\u1077?\u1085?\u1080?\u1077?: \{excess\} \u1082?\u1075?."\par
            )\par
    elif max_capacity is not None:\par
        info["production_capacity"] = max_capacity\par
        info["production_reserved"] = 0\par
\par
    equipment_requirements = \{\}\par
    for item in items:\par
        if not item.dish:\par
            continue\par
        for req in DishEquipmentRequirement.objects.filter(dish=item.dish).select_related("equipment"):\par
            minutes = (req.minutes_per_unit or 0) * (item.quantity or 0)\par
            equipment_requirements[req.equipment_id] = equipment_requirements.get(req.equipment_id, 0) + minutes\par
\par
    for eq_id, minutes in equipment_requirements.items():\par
        eq = DishEquipmentRequirement.objects.filter(equipment_id=eq_id).select_related("equipment").first().equipment\par
        available_hours = float(eq.available_hours or 0)\par
        reserved_hours = EquipmentReservation.objects.filter(equipment=eq, production_date=order.production_date).exclude(\par
            order=order\par
        ).aggregate(total=Sum("hours"))["total"] or 0\par
        required_hours = minutes / 60\par
        if available_hours and reserved_hours + required_hours > available_hours:\par
            errors.append(f"\u1055?\u1088?\u1077?\u1074?\u1099?\u1096?\u1077?\u1085? \u1083?\u1080?\u1084?\u1080?\u1090? \u1086?\u1073?\u1086?\u1088?\u1091?\u1076?\u1086?\u1074?\u1072?\u1085?\u1080?\u1103?: \{eq.name\}")\par
\par
    ingredients_need = \{\}\par
    for item in items:\par
        if not item.custom_tech_card and item.dish:\par
            active = TechCard.objects.filter(dish=item.dish, is_active=True).order_by("-id").first()\par
            if active:\par
                item.custom_tech_card = active\par
        if not item.custom_tech_card:\par
            continue\par
        for comp in TechCardComponent.objects.filter(tech_card=item.custom_tech_card):\par
            qty = (comp.quantity or 0) * (item.quantity or 0)\par
            ingredients_need[comp.ingredient_id] = ingredients_need.get(comp.ingredient_id, 0) + qty\par
\par
    ingredient_warnings = []\par
    ingredients_map = Ingredient.objects.in_bulk(list(ingredients_need.keys()))\par
    for ingredient_id, qty in ingredients_need.items():\par
        stock = IngredientStock.objects.filter(ingredient_id=ingredient_id).first()\par
        available = stock.quantity if stock else 0\par
        reserved = IngredientReservation.objects.filter(ingredient_id=ingredient_id, production_date=order.production_date).exclude(\par
            order=order\par
        ).aggregate(total=Sum("quantity"))["total"] or 0\par
        missing = qty - (available - reserved)\par
        if missing > 0:\par
            ingredient = ingredients_map.get(ingredient_id)\par
            ingredient_warnings.append(\par
                \{\par
                    "id": ingredient_id,\par
                    "name": ingredient.name if ingredient else f"ID \{ingredient_id\}",\par
                    "required": float(qty),\par
                    "available": float(available),\par
                    "reserved": float(reserved),\par
                    "missing": float(missing),\par
                \}\par
            )\par
    if ingredient_warnings:\par
        errors.append("\u1053?\u1077?\u1076?\u1086?\u1089?\u1090?\u1072?\u1090?\u1086?\u1095?\u1085?\u1086? \u1080?\u1085?\u1075?\u1088?\u1077?\u1076?\u1080?\u1077?\u1085?\u1090?\u1086?\u1074? \u1076?\u1083?\u1103? \u1079?\u1072?\u1082?\u1072?\u1079?\u1072?. \u1055?\u1088?\u1086?\u1074?\u1077?\u1088?\u1100?\u1090?\u1077? \u1089?\u1087?\u1080?\u1089?\u1086?\u1082? \u1085?\u1080?\u1078?\u1077?.")\par
        info["ingredient_warnings"] = ingredient_warnings\par
\par
    for item in items:\par
        if not item.dish:\par
            continue\par
        if item.dish.min_batch_qty and (item.quantity or 0) < item.dish.min_batch_qty:\par
            errors.append(f"\u1052?\u1080?\u1085?\u1080?\u1084?\u1072?\u1083?\u1100?\u1085?\u1072?\u1103? \u1087?\u1072?\u1088?\u1090?\u1080?\u1103? \u1076?\u1083?\u1103? \{item.dish.name\} \u8212? \{item.dish.min_batch_qty\}")\par
        if item.dish.batch_multiple_qty and (item.quantity or 0) % item.dish.batch_multiple_qty != 0:\par
            errors.append(f"\u1050?\u1086?\u1083?\u1080?\u1095?\u1077?\u1089?\u1090?\u1074?\u1086? \u1076?\u1083?\u1103? \{item.dish.name\} \u1076?\u1086?\u1083?\u1078?\u1085?\u1086? \u1073?\u1099?\u1090?\u1100? \u1082?\u1088?\u1072?\u1090?\u1085?\u1086? \{item.dish.batch_multiple_qty\}")\par
\par
    return errors, warnings, info\par
