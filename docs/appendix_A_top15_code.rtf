class BootstrapFormMixin:\par
    def _init_bootstrap(self):\par
        for field in self.fields.values():\par
            widget = field.widget\par
            if isinstance(widget, forms.CheckboxInput):\par
                widget.attrs.setdefault("class", "form-check-input")\par
                continue\par
            if isinstance(widget, (forms.Select, forms.SelectMultiple)):\par
                widget.attrs.setdefault("class", "form-select")\par
                continue\par
            widget.attrs.setdefault("class", "form-control")\par
