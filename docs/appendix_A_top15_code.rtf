def _route_metrics(route):\par
    stops = RouteStop.objects.filter(route=route).select_related("delivery")\par
    total_weight = sum([(s.delivery.cargo_weight_kg or 0) for s in stops])\par
    total_volume = sum([(s.delivery.cargo_volume_m3 or 0) for s in stops])\par
    total_stops = stops.count()\par
    service_minutes = sum([(s.service_time_minutes or 0) for s in stops])\par
\par
    points = []\par
    for s in stops.order_by("sequence_index"):\par
        if s.latitude is not None and s.longitude is not None:\par
            points.append((float(s.latitude), float(s.longitude)))\par
\par
    depot_lat = getattr(settings, "LOGISTICS_DEPOT_LAT", None)\par
    depot_lng = getattr(settings, "LOGISTICS_DEPOT_LNG", None)\par
    if depot_lat is not None and depot_lng is not None:\par
        points_with_depot = [(float(depot_lat), float(depot_lng))] + points\par
    else:\par
        points_with_depot = points\par
\par
    distance_km = 0\par
    for idx in range(1, len(points_with_depot)):\par
        lat1, lon1 = points_with_depot[idx - 1]\par
        lat2, lon2 = points_with_depot[idx]\par
        distance_km += _haversine_km(lat1, lon1, lat2, lon2)\par
\par
    if getattr(settings, "LOGISTICS_RETURN_TO_DEPOT", False) and depot_lat is not None and depot_lng is not None and points:\par
        lat1, lon1 = points[-1]\par
        distance_km += _haversine_km(lat1, lon1, float(depot_lat), float(depot_lng))\par
\par
    avg_speed = getattr(settings, "LOGISTICS_AVG_SPEED_KMH", 35)\par
    travel_minutes = (distance_km / avg_speed) * 60 if avg_speed else 0\par
    duration_minutes = int(travel_minutes + service_minutes)\par
\par
    return \{\par
        "total_weight": total_weight,\par
        "total_volume": total_volume,\par
        "total_stops": total_stops,\par
        "distance_km": round(distance_km, 1),\par
        "duration_minutes": duration_minutes,\par
        "service_minutes": service_minutes,\par
        "travel_minutes": int(travel_minutes),\par
    \}\par
\par
\par
def _route_validation(route):\par
    metrics = _route_metrics(route)\par
    errors = []\par
    warnings = []\par
\par
    if metrics["duration_minutes"] > route.max_duration_minutes:\par
        errors.append(\par
            f"\u1055?\u1088?\u1077?\u1074?\u1099?\u1096?\u1077?\u1085?\u1080?\u1077? \u1083?\u1080?\u1084?\u1080?\u1090?\u1072? \u1074?\u1088?\u1077?\u1084?\u1077?\u1085?\u1080?: \{metrics['duration_minutes']\} \u1084?\u1080?\u1085? > \{route.max_duration_minutes\} \u1084?\u1080?\u1085?"\par
        )\par
\par
    courier = None\par
    assignment = CourierAssignment.objects.filter(route=route).select_related("courier").first()\par
    if assignment:\par
        courier = assignment.courier\par
    capacity_weight = (courier.max_weight if courier else None) or (courier.payload_capacity_kg if courier else None)\par
    capacity_volume = (courier.max_volume if courier else None) or (courier.cargo_volume_m3 if courier else None)\par
    if capacity_weight and metrics["total_weight"] > capacity_weight:\par
        errors.append("\u1055?\u1088?\u1077?\u1074?\u1099?\u1096?\u1077?\u1085?\u1080?\u1077? \u1083?\u1080?\u1084?\u1080?\u1090?\u1072? \u1074?\u1077?\u1089?\u1072?")\par
    if capacity_volume and metrics["total_volume"] > capacity_volume:\par
        errors.append("\u1055?\u1088?\u1077?\u1074?\u1099?\u1096?\u1077?\u1085?\u1080?\u1077? \u1083?\u1080?\u1084?\u1080?\u1090?\u1072? \u1086?\u1073?\u1098?\u1105?\u1084?\u1072?")\par
\par
    if metrics["total_stops"] > route.soft_limit_stops:\par
        message = f"\u1055?\u1088?\u1077?\u1074?\u1099?\u1096?\u1077?\u1085? \u1084?\u1103?\u1075?\u1082?\u1080?\u1081? \u1083?\u1080?\u1084?\u1080?\u1090? \u1090?\u1086?\u1095?\u1077?\u1082?: \{metrics['total_stops']\} > \{route.soft_limit_stops\}"\par
        if route.strict_mode:\par
            errors.append(message)\par
        else:\par
            warnings.append(message)\par
\par
    return metrics, errors, warnings\par
\par
def _courier_is_suitable(delivery, courier):\par
    if courier.status != CourierStatus.FREE:\par
        return False\par
    capacity_weight = courier.max_weight or courier.payload_capacity_kg\par
    capacity_volume = courier.max_volume or courier.cargo_volume_m3\par
    if delivery.cargo_weight_kg and not capacity_weight:\par
        return False\par
    if delivery.cargo_weight_kg and capacity_weight and delivery.cargo_weight_kg > capacity_weight:\par
        return False\par
    if delivery.cargo_volume_m3 and not capacity_volume:\par
        return False\par
    if delivery.cargo_volume_m3 and capacity_volume and delivery.cargo_volume_m3 > capacity_volume:\par
        return False\par
    for delivery_dim, courier_dim in [\par
        (delivery.cargo_length_cm, courier.cargo_length_cm),\par
        (delivery.cargo_width_cm, courier.cargo_width_cm),\par
        (delivery.cargo_height_cm, courier.cargo_height_cm),\par
    ]:\par
        if delivery_dim and not courier_dim:\par
            return False\par
        if delivery_dim and courier_dim and delivery_dim > courier_dim:\par
            return False\par
    return True\par
\par
