def _attach_tech_card(order, item):\par
    if not item.dish:\par
        return\par
    allowed = ClientAllowedTechCard.objects.filter(client=order.client, tech_card__dish=item.dish, tech_card__is_active=True)\par
    if allowed.exists():\par
        item.custom_tech_card = allowed.first().tech_card\par
        return\par
    active = TechCard.objects.filter(dish=item.dish, is_active=True).order_by("-id")\par
    if active.count() == 1:\par
        item.custom_tech_card = active.first()\par
        return\par
    raise ValueError("\u1044?\u1083?\u1103? \u1073?\u1083?\u1102?\u1076?\u1072? \u1085?\u1077?\u1090? \u1072?\u1082?\u1090?\u1080?\u1074?\u1085?\u1086?\u1081? \u1090?\u1077?\u1093?\u1082?\u1072?\u1088?\u1090?\u1099? \u1080?\u1083?\u1080? \u1080?\u1093? \u1085?\u1077?\u1089?\u1082?\u1086?\u1083?\u1100?\u1082?\u1086? \u1073?\u1077?\u1079? \u1088?\u1072?\u1079?\u1088?\u1077?\u1096?\u1077?\u1085?\u1080?\u1103? \u1082?\u1083?\u1080?\u1077?\u1085?\u1090?\u1072?.")\par
