    )\par
    production_date = models.DateField('\u1044?\u1072?\u1090?\u1072? \u1087?\u1088?\u1086?\u1080?\u1079?\u1074?\u1086?\u1076?\u1089?\u1090?\u1074?\u1072?', null=True, blank=True)\par
