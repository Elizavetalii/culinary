def _build_google_maps_dir_url(addresses):\par
    if len(addresses) < 2:\par
        return ""\par
    origin = quote(addresses[0])\par
    destination = quote(addresses[-1])\par
    waypoints = "|".join(quote(a) for a in addresses[1:-1])\par
    url = f"https://www.google.com/maps/dir/?api=1&origin=\{origin\}&destination=\{destination\}"\par
    if waypoints:\par
        url += f"&waypoints=\{waypoints\}"\par
    return url\par
