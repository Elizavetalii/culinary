RESERVED_STATUSES = \{\par
    OrderStatus.CONFIRMED,\par
    OrderStatus.IN_PRODUCTION,\par
    OrderStatus.READY_TO_SHIP,\par
    OrderStatus.SHIPPED,\par
\}\par
\par
\par
def _get_reserved_qty_map(production_date, exclude_order_id=None):\par
    if not production_date:\par
        return \{\}\par
    qs = OrderItem.objects.filter(\par
        order__delivery_date=production_date,\par
        order__status__in=RESERVED_STATUSES,\par
        dish__isnull=False,\par
    )\par
    if exclude_order_id:\par
        qs = qs.exclude(order_id=exclude_order_id)\par
    data = qs.values("dish_id").annotate(total=Sum("quantity"))\par
    return \{row["dish_id"]: row["total"] for row in data\}\par
\par
\par
def _validate_dish_capacity(order, items):\par
    reserved_map = _get_reserved_qty_map(order.delivery_date, exclude_order_id=order.id)\par
    requested_map = \{\}\par
    for item in items:\par
        if not item.dish_id:\par
            continue\par
        requested_map[item.dish_id] = requested_map.get(item.dish_id, 0) + (item.quantity or 0)\par
\par
    errors = []\par
    for dish_id, requested_qty in requested_map.items():\par
        dish = Dish.objects.filter(pk=dish_id).only("id", "name", "daily_capacity").first()\par
        if not dish or dish.daily_capacity is None:\par
            continue\par
        reserved_qty = reserved_map.get(dish_id, 0) or 0\par
        available_qty = max(dish.daily_capacity - reserved_qty, 0)\par
        if requested_qty > available_qty:\par
            errors.append(\par
                f"\u1053?\u1077?\u1076?\u1086?\u1089?\u1090?\u1072?\u1090?\u1086?\u1095?\u1085?\u1072?\u1103? \u1084?\u1086?\u1097?\u1085?\u1086?\u1089?\u1090?\u1100? \u1076?\u1083?\u1103? \u171?\{dish.name\}\u187?: \u1076?\u1086?\u1089?\u1090?\u1091?\u1087?\u1085?\u1086? \{available_qty\}, \u1079?\u1072?\u1087?\u1088?\u1086?\u1096?\u1077?\u1085?\u1086? \{requested_qty\}."\par
            )\par
    return errors\par
