def _normalize_route_stop_sequence(route):\par
    stops = RouteStop.objects.filter(route=route).order_by("sequence_index", "id")\par
    for idx, stop in enumerate(stops, start=1):\par
        if stop.sequence_index != idx:\par
            RouteStop.objects.filter(pk=stop.pk).update(sequence_index=idx)\par
