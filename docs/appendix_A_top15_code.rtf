    def __init__(self, *args, **kwargs):\par
        super().__init__(*args, **kwargs)\par
        self._init_bootstrap()\par
        if "status" in self.fields:\par
            allowed = ["\u1053?\u1077? \u1085?\u1072?\u1079?\u1085?\u1072?\u1095?\u1077?\u1085?\u1086?", "\u1047?\u1072?\u1087?\u1083?\u1072?\u1085?\u1080?\u1088?\u1086?\u1074?\u1072?\u1085?\u1086?"]\par
            self.fields["status"].choices = [\par
                (value, label)\par
                for value, label in self.fields["status"].choices\par
                if value in allowed\par
            ]\par
        for name in ("planned_at", "departure_time", "delivered_at"):\par
            if name in self.fields:\par
                self.fields[name].input_formats = ["%Y-%m-%dT%H:%M"]\par
\par
    def clean(self):\par
        cleaned = super().clean()\par
        status = cleaned.get("status")\par
        courier = cleaned.get("courier")\par
        route = cleaned.get("route")\par
        planned_at = cleaned.get("planned_at")\par
        departure_time = cleaned.get("departure_time")\par
        delivered_at = cleaned.get("delivered_at")\par
        note = cleaned.get("note")\par
\par
        if status in ["\u1047?\u1072?\u1087?\u1083?\u1072?\u1085?\u1080?\u1088?\u1086?\u1074?\u1072?\u1085?\u1086?", "\u1042? \u1087?\u1091?\u1090?\u1080?", "\u1044?\u1086?\u1089?\u1090?\u1072?\u1074?\u1083?\u1077?\u1085?\u1086?"] and not courier:\par
            self.add_error("courier", "\u1053?\u1091?\u1078?\u1085?\u1086? \u1085?\u1072?\u1079?\u1085?\u1072?\u1095?\u1080?\u1090?\u1100? \u1082?\u1091?\u1088?\u1100?\u1077?\u1088?\u1072?.")\par
        if status in ["\u1047?\u1072?\u1087?\u1083?\u1072?\u1085?\u1080?\u1088?\u1086?\u1074?\u1072?\u1085?\u1086?", "\u1042? \u1087?\u1091?\u1090?\u1080?", "\u1044?\u1086?\u1089?\u1090?\u1072?\u1074?\u1083?\u1077?\u1085?\u1086?"] and not planned_at:\par
            self.add_error("planned_at", "\u1053?\u1091?\u1078?\u1085?\u1086? \u1091?\u1082?\u1072?\u1079?\u1072?\u1090?\u1100? \u1087?\u1083?\u1072?\u1085?\u1086?\u1074?\u1091?\u1102? \u1076?\u1072?\u1090?\u1091?/\u1074?\u1088?\u1077?\u1084?\u1103?.")\par
        if status in ["\u1042? \u1087?\u1091?\u1090?\u1080?", "\u1044?\u1086?\u1089?\u1090?\u1072?\u1074?\u1083?\u1077?\u1085?\u1086?"] and not route:\par
