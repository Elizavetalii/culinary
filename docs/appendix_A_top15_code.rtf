from functools import wraps\par
from django.shortcuts import redirect\par
\par
\par
def role_required(role_name: str):\par
    def decorator(view_func):\par
        @wraps(view_func)\par
        def _wrapped(request, *args, **kwargs):\par
            if not request.user.is_authenticated:\par
                return redirect("/login/")\par
            if not request.user.roles.filter(name__iexact=role_name).exists():\par
                return redirect("/login/")\par
            return view_func(request, *args, **kwargs)\par
        return _wrapped\par
    return decorator\par
