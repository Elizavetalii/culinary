            ('\u1056?\u1072?\u1079?\u1086?\u1074?\u1072?\u1103?', '\u1056?\u1072?\u1079?\u1086?\u1074?\u1072?\u1103?'),\par
            ('\u1057?\u1088?\u1086?\u1095?\u1085?\u1072?\u1103?', '\u1057?\u1088?\u1086?\u1095?\u1085?\u1072?\u1103?'),\par
        ],\par
