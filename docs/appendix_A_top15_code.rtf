def _order_item_weight(item):\par
    if not item.dish:\par
        return item.quantity or 0\par
    if item.dish.base_uom == Dish.BaseUom.KG:\par
        return item.quantity or 0\par
    if item.dish.base_uom == Dish.BaseUom.PCS:\par
        if item.dish.unit_weight_kg:\par
            return (item.quantity or 0) * item.dish.unit_weight_kg\par
        return 0\par
    return item.quantity or 0\par
\par
