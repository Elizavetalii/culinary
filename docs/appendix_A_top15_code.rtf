\par
    def save(self, *args, **kwargs):\par
        self.line_total = (self.quantity or 0) * (self.unit_price or 0)\par
        super().save(*args, **kwargs)\par
        if self.order_id:\par
            self.order.recalc_total()\par
\par
    def delete(self, *args, **kwargs):\par
        order = self.order\par
        super().delete(*args, **kwargs)\par
        if order:\par
            order.recalc_total()\par
\par
    def display_name(self):\par
        if self.dish:\par
            return self.dish.name\par
        if self.ingredient:\par
            return self.ingredient.name\par
        if self.custom_tech_card:\par
            return str(self.custom_tech_card)\par
        return "\u1055?\u1086?\u1079?\u1080?\u1094?\u1080?\u1103?"\par
\par
    def __str__(self):\par
        subject = self.dish or self.ingredient or self.custom_tech_card or '\u1055?\u1086?\u1079?\u1080?\u1094?\u1080?\u1103?'\par
        return f"\{subject\} x \{self.quantity\}"\par
