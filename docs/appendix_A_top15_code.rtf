\par
    class Meta:\par
        verbose_name = '\u1055?\u1086?\u1083?\u1100?\u1079?\u1086?\u1074?\u1072?\u1090?\u1077?\u1083?\u1100?'\par
        verbose_name_plural = '\u1055?\u1086?\u1083?\u1100?\u1079?\u1086?\u1074?\u1072?\u1090?\u1077?\u1083?\u1080?'\par
\par
    def __str__(self):\par
        return self.full_name or self.username\par
\par
\par
class UserRole(models.Model):\par
    user = models.ForeignKey(User, on_delete=models.CASCADE)\par
    role = models.ForeignKey(Role, on_delete=models.CASCADE)\par
    assigned_at = models.DateTimeField(default=timezone.now)\par
\par
    class Meta:\par
        unique_together = ('user', 'role')\par
        verbose_name = '\u1056?\u1086?\u1083?\u1100? \u1087?\u1086?\u1083?\u1100?\u1079?\u1086?\u1074?\u1072?\u1090?\u1077?\u1083?\u1103?'\par
