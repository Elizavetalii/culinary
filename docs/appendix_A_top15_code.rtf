@role_required("\u1050?\u1091?\u1088?\u1100?\u1077?\u1088?")\par
def courier_upload_proof(request, pk):\par
    courier, _ = _get_or_create_courier_profile(request.user)\par
    stop = get_object_or_404(RouteStop, pk=pk)\par
    if not CourierAssignment.objects.filter(route=stop.route, courier=courier).exists():\par
        return HttpResponseBadRequest("\u1054?\u1089?\u1090?\u1072?\u1085?\u1086?\u1074?\u1082?\u1072? \u1085?\u1077?\u1076?\u1086?\u1089?\u1090?\u1091?\u1087?\u1085?\u1072?.")\par
    form = ProofUploadForm(request.POST or None, request.FILES or None, instance=stop)\par
    if request.method == "POST" and form.is_valid():\par
        uploaded = request.FILES.get("proof_of_delivery")\par
        if uploaded:\par
            ext = f".\{uploaded.name.split('.')[-1].lower()\}" if "." in uploaded.name else ""\par
            allowed = getattr(settings, "LOGISTICS_ALLOWED_PROOF_EXT", [".pdf", ".jpg", ".jpeg", ".png"])\par
            if ext not in allowed:\par
                return HttpResponseBadRequest("\u1053?\u1077?\u1076?\u1086?\u1087?\u1091?\u1089?\u1090?\u1080?\u1084?\u1099?\u1081? \u1092?\u1086?\u1088?\u1084?\u1072?\u1090? \u1092?\u1072?\u1081?\u1083?\u1072?.")\par
        else:\par
            return HttpResponseBadRequest("\u1044?\u1086?\u1082?\u1091?\u1084?\u1077?\u1085?\u1090? \u1076?\u1086?\u1089?\u1090?\u1072?\u1074?\u1082?\u1080? \u1086?\u1073?\u1103?\u1079?\u1072?\u1090?\u1077?\u1083?\u1077?\u1085?.")\par
        stop = form.save(commit=False)\par
        stop.proof_uploaded_at = timezone.now()\par
        stop.proof_uploaded_by = request.user\par
        stop.proof_review_status = RouteStop.ProofReviewStatus.PENDING\par
        if request.POST.get("status") == RouteStop.StopStatus.DONE:\par
            stop.status = RouteStop.StopStatus.DONE\par
            stop.actual_time = timezone.now()\par
        stop.save(\par
            update_fields=[\par
                "proof_of_delivery",\par
                "proof_uploaded_at",\par
                "proof_uploaded_by",\par
                "proof_review_status",\par
                "status",\par
                "actual_time",\par
            ]\par
        )\par
        _log_action(request.user, stop, "proof_of_delivery", "", stop.proof_of_delivery.name)\par
        messages.success(request, "\u1044?\u1086?\u1082?\u1091?\u1084?\u1077?\u1085?\u1090? \u1079?\u1072?\u1075?\u1088?\u1091?\u1078?\u1077?\u1085?.")\par
    return redirect(f"/courier/routes/\{stop.route.id\}/")\par
