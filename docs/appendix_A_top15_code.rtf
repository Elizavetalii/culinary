    deliveries = Delivery.objects.select_related("order", "courier", "route").all()\par
    status = request.GET.get("status")\par
    date = request.GET.get("date")\par
    courier_id = request.GET.get("courier")\par
    route_id = request.GET.get("route")\par
    client_id = request.GET.get("client")\par
    sort = request.GET.get("sort")\par
    if status:\par
        deliveries = deliveries.filter(status=status)\par
    else:\par
        deliveries = deliveries.exclude(status__in=[Delivery.DeliveryStatus.DELIVERED, Delivery.DeliveryStatus.CANCELLED])\par
    if date:\par
        deliveries = deliveries.filter(planned_at__date=date)\par
    if courier_id:\par
        deliveries = deliveries.filter(courier_id=courier_id)\par
    if route_id:\par
        deliveries = deliveries.filter(route_id=route_id)\par
    if client_id:\par
        deliveries = deliveries.filter(order__client_id=client_id)\par
    if sort in ["planned_at", "-planned_at", "status", "-status"]:\par
        deliveries = deliveries.order_by(sort)\par
    if sort in ["client", "-client"]:\par
        deliveries = deliveries.order_by(f"\{'-' if sort.startswith('-') else ''\}order__client__name")\par
    orders_without_delivery = Order.objects.filter(\par
        is_archived=False,\par
        status__in=[\par
            OrderStatus.CONFIRMED,\par
            OrderStatus.IN_PRODUCTION,\par
            OrderStatus.READY_TO_SHIP,\par
            OrderStatus.SHIPPED,\par
        ],\par
        deliveries__isnull=True,\par
    ).select_related("client")\par
    couriers = Courier.objects.select_related("user").all()\par
    routes = Route.objects.all()\par
    clients = Client.objects.all()\par
\par
    if request.GET.get("export") == "1":\par
        response = HttpResponse(content_type="text/csv")\par
        response["Content-Disposition"] = "attachment; filename=deliveries.csv"\par
        response.write("\u1053?\u1086?\u1084?\u1077?\u1088? \u1079?\u1072?\u1082?\u1072?\u1079?\u1072?;\u1050?\u1083?\u1080?\u1077?\u1085?\u1090?;\u1040?\u1076?\u1088?\u1077?\u1089?;\u1055?\u1083?\u1072?\u1085?;\u1050?\u1091?\u1088?\u1100?\u1077?\u1088?;\u1052?\u1072?\u1088?\u1096?\u1088?\u1091?\u1090?;\u1057?\u1090?\u1072?\u1090?\u1091?\u1089?\\n")\par
        for d in deliveries:\par
            response.write(\par
                f"\{d.order.order_number\};\{d.order.client.name\};\{d.address or ''\};"\par
                f"\{d.planned_at or ''\};\{d.courier.user.full_name if d.courier else ''\};"\par
                f"\{d.route.planned_date if d.route else ''\};\{d.get_status_display()\}\\n"\par
            )\par
        return response\par
    return render(\par
        request,\par
        "logistics/list.html",\par
        \{\par
            "deliveries": deliveries,\par
            "status_choices": Delivery.DeliveryStatus.choices,\par
            "orders_without_delivery": orders_without_delivery,\par
            "couriers": couriers,\par
            "routes": routes,\par
            "clients": clients,\par
        \},\par
    )\par
