    production_window_end = models.TimeField('\u1054?\u1082?\u1085?\u1086? \u1087?\u1088?\u1086?\u1080?\u1079?\u1074?\u1086?\u1076?\u1089?\u1090?\u1074?\u1072? (\u1076?\u1086?)', null=True, blank=True)\par
    comments = models.TextField('\u1050?\u1086?\u1084?\u1084?\u1077?\u1085?\u1090?\u1072?\u1088?\u1080?\u1080?', blank=True)\par
    total_amount = models.DecimalField('\u1057?\u1091?\u1084?\u1084?\u1072? \u1080?\u1090?\u1086?\u1075?\u1086?', max_digits=12, decimal_places=2, default=0)\par
    is_archived = models.BooleanField('\u1042? \u1072?\u1088?\u1093?\u1080?\u1074?\u1077?', default=False)\par
    created_at = models.DateTimeField(auto_now_add=True)\par
    updated_at = models.DateTimeField(auto_now=True)\par
\par
    @classmethod\par
    def generate_order_number(cls):\par
        date_part = timezone.now().strftime("%Y%m%d")\par
        base = f"ORD-\{date_part\}-"\par
        last = cls.objects.filter(order_number__startswith=base).order_by("-order_number").first()\par
        seq = 1\par
        if last and last.order_number.split("-")[-1].isdigit():\par
            seq = int(last.order_number.split("-")[-1]) + 1\par
        return f"\{base\}\{seq:03d\}"\par
\par
    class Meta:\par
        ordering = ['-created_at']\par
        verbose_name = '\u1047?\u1072?\u1082?\u1072?\u1079?'\par
        verbose_name_plural = '\u1047?\u1072?\u1082?\u1072?\u1079?\u1099?'\par
\par
    def __str__(self):\par
        return f"\u1047?\u1072?\u1082?\u1072?\u1079? \{self.order_number\}"\par
\par
    def recalc_total(self):\par
        total = self.items.aggregate(total=Sum("line_total"))["total"] or 0\par
        if self.total_amount != total:\par
            self.total_amount = total\par
            self.save(update_fields=["total_amount"])\par
