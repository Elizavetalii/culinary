from django.contrib.auth import authenticate, login, logout, get_user_model\par
from django.shortcuts import render, redirect\par
from django.contrib import messages\par
\par
\par
def _role_redirect(user):\par
    if user.roles.filter(name__iexact="\u1052?\u1077?\u1085?\u1077?\u1076?\u1078?\u1077?\u1088?").exists():\par
        return "/dashboard/manager/"\par
    if user.roles.filter(name__iexact="\u1051?\u1086?\u1075?\u1080?\u1089?\u1090?").exists():\par
        return "/dashboard/logistic/"\par
    if user.roles.filter(name__iexact="\u1057?\u1073?\u1086?\u1088?\u1097?\u1080?\u1082? \u1079?\u1072?\u1082?\u1072?\u1079?\u1086?\u1074?").exists():\par
        return "/dashboard/picker/"\par
    if user.roles.filter(name__iexact="\u1050?\u1091?\u1088?\u1100?\u1077?\u1088?").exists():\par
        return "/logistics/courier/routes/"\par
    if user.roles.filter(name__iexact="\u1040?\u1076?\u1084?\u1080?\u1085?\u1080?\u1089?\u1090?\u1088?\u1072?\u1090?\u1086?\u1088? \u1089?\u1080?\u1089?\u1090?\u1077?\u1084?\u1099?").exists():\par
        return "/dashboard/admin/"\par
    return None\par
\par
\par
def login_view(request):\par
    if request.user.is_authenticated:\par
        target = _role_redirect(request.user)\par
        if target:\par
            return redirect(target)\par
        logout(request)\par
        messages.error(request, "\u1059? \u1074?\u1072?\u1096?\u1077?\u1075?\u1086? \u1072?\u1082?\u1082?\u1072?\u1091?\u1085?\u1090?\u1072? \u1085?\u1077?\u1090? \u1088?\u1086?\u1083?\u1080?. \u1042?\u1086?\u1081?\u1076?\u1080?\u1090?\u1077? \u1087?\u1086?\u1076? \u1076?\u1088?\u1091?\u1075?\u1086?\u1081? \u1091?\u1095?\u1105?\u1090?\u1085?\u1086?\u1081? \u1079?\u1072?\u1087?\u1080?\u1089?\u1100?\u1102?.")\par
    if request.method == "POST":\par
        username = request.POST.get("username", "").strip()\par
        password = request.POST.get("password", "").strip()\par
\par
        user = None\par
        if "@" in username:\par
            User = get_user_model()\par
            candidate = User.objects.filter(email__iexact=username).first()\par
            if candidate:\par
                user = authenticate(request, username=candidate.username, password=password)\par
        else:\par
            user = authenticate(request, username=username, password=password)\par
\par
        if user is None:\par
            messages.error(request, "\u1053?\u1077?\u1074?\u1077?\u1088?\u1085?\u1099?\u1081? \u1083?\u1086?\u1075?\u1080?\u1085? \u1080?\u1083?\u1080? \u1087?\u1072?\u1088?\u1086?\u1083?\u1100?.")\par
        else:\par
            login(request, user)\par
            target = _role_redirect(user)\par
            if target:\par
                return redirect(target)\par
            logout(request)\par
            messages.error(request, "\u1053?\u1077?\u1090? \u1087?\u1088?\u1072?\u1074? \u1076?\u1086?\u1089?\u1090?\u1091?\u1087?\u1072?. \u1059? \u1087?\u1086?\u1083?\u1100?\u1079?\u1086?\u1074?\u1072?\u1090?\u1077?\u1083?\u1103? \u1085?\u1077? \u1085?\u1072?\u1079?\u1085?\u1072?\u1095?\u1077?\u1085?\u1072? \u1088?\u1086?\u1083?\u1100?.")\par
    return render(request, "accounts/login.html")\par
\par
\par
def logout_view(request):\par
    logout(request)\par
    return redirect("/login/")\par
\par
