@roles_required(["\u1052?\u1077?\u1085?\u1077?\u1076?\u1078?\u1077?\u1088?", "\u1040?\u1076?\u1084?\u1080?\u1085?\u1080?\u1089?\u1090?\u1088?\u1072?\u1090?\u1086?\u1088? \u1089?\u1080?\u1089?\u1090?\u1077?\u1084?\u1099?"])\par
def order_create(request):\par
    form = OrderForm(request.POST or None)\par
    formset = OrderItemFormSet(request.POST or None, queryset=OrderItem.objects.none())\par
    dish_prices = \{d.id: float(d.default_price) for d in Dish.objects.filter(is_active=True, default_price__isnull=False)\}\par
    if request.method == "POST" and form.is_valid() and formset.is_valid():\par
        with transaction.atomic():\par
            obj = form.save(commit=False)\par
            if request.user.roles.filter(name__iexact="\u1052?\u1077?\u1085?\u1077?\u1076?\u1078?\u1077?\u1088?").exists():\par
                obj.manager = request.user\par
            action = request.POST.get("action", "save")\par
            obj.status = OrderStatus.DRAFT if action == "draft" else OrderStatus.REVIEW\par
            _apply_production_fields(obj)\par
            _ensure_order_number(obj)\par
            obj.save()\par
            items = [i for i in formset.save(commit=False) if i.dish]\par
            if not items:\par
                messages.error(request, "\u1044?\u1086?\u1073?\u1072?\u1074?\u1100?\u1090?\u1077? \u1093?\u1086?\u1090?\u1103? \u1073?\u1099? \u1086?\u1076?\u1085?\u1091? \u1087?\u1086?\u1079?\u1080?\u1094?\u1080?\u1102? \u1079?\u1072?\u1082?\u1072?\u1079?\u1072?.")\par
                return render(\par
                request,\par
                "orders/form.html",\par
                \{"form": form, "formset": formset, "title": "\u1053?\u1086?\u1074?\u1099?\u1081? \u1079?\u1072?\u1082?\u1072?\u1079?", "dish_prices": dish_prices\},\par
            )\par
        errors, warnings, info = _validate_order_capacity(obj, items)\par
        if errors:\par
            clients = Client.objects.all()\par
            for err in errors:\par
                messages.error(request, err)\par
            return render(\par
                request,\par
                "orders/form.html",\par
                \{"form": form, "formset": formset, "title": "\u1053?\u1086?\u1074?\u1099?\u1081? \u1079?\u1072?\u1082?\u1072?\u1079?", "warnings": warnings, "info": info, "clients": clients, "dish_prices": dish_prices\},\par
            )\par
            capacity_errors = _validate_dish_capacity(obj, items)\par
            if capacity_errors:\par
                clients = Client.objects.all()\par
                for err in capacity_errors:\par
                    messages.error(request, err)\par
                return render(\par
                    request,\par
                    "orders/form.html",\par
                    \{"form": form, "formset": formset, "title": "\u1053?\u1086?\u1074?\u1099?\u1081? \u1079?\u1072?\u1082?\u1072?\u1079?", "warnings": warnings, "info": info, "clients": clients\},\par
                )\par
            for item in items:\par
                item.order = obj\par
                try:\par
                    _attach_tech_card(obj, item)\par
                except ValueError as exc:\par
                    messages.error(request, str(exc))\par
                    clients = Client.objects.all()\par
                return render(\par
                    request,\par
                    "orders/form.html",\par
                    \{"form": form, "formset": formset, "title": "\u1053?\u1086?\u1074?\u1099?\u1081? \u1079?\u1072?\u1082?\u1072?\u1079?", "warnings": warnings, "info": info, "clients": clients, "dish_prices": dish_prices\},\par
                )\par
            if item.unit_price is None and item.dish and item.dish.default_price is not None:\par
                item.unit_price = item.dish.default_price\par
            if item.unit_price is None:\par
                messages.error(request, f"\u1062?\u1077?\u1085?\u1072? \u1085?\u1077? \u1079?\u1072?\u1076?\u1072?\u1085?\u1072? \u1076?\u1083?\u1103? \u1073?\u1083?\u1102?\u1076?\u1072? \u171?\{item.dish\}\u187?.")\par
                clients = Client.objects.all()\par
                return render(\par
                    request,\par
                    "orders/form.html",\par
                    \{"form": form, "formset": formset, "title": "\u1053?\u1086?\u1074?\u1099?\u1081? \u1079?\u1072?\u1082?\u1072?\u1079?", "warnings": warnings, "info": info, "clients": clients, "dish_prices": dish_prices\},\par
                )\par
                item.save()\par
            for deleted in formset.deleted_objects:\par
                deleted.delete()\par
            _reserve_resources(obj)\par
            if obj.status in [OrderStatus.CONFIRMED, OrderStatus.READY_TO_SHIP, OrderStatus.SHIPPED] and not obj.deliveries.exists():\par
                Delivery.objects.create(\par
                    order=obj,\par
                    address=obj.address,\par
                    status=Delivery.DeliveryStatus.UNASSIGNED,\par
                )\par
            messages.success(request, "\u1047?\u1072?\u1082?\u1072?\u1079? \u1089?\u1086?\u1079?\u1076?\u1072?\u1085?.")\par
            return redirect("/orders/")\par
    clients = Client.objects.all()\par
    return render(\par
        request,\par
        "orders/form.html",\par
        \{"form": form, "formset": formset, "title": "\u1053?\u1086?\u1074?\u1099?\u1081? \u1079?\u1072?\u1082?\u1072?\u1079?", "clients": clients, "dish_prices": dish_prices\},\par
    )\par
