                    "orders/form.html",\par
                    \{"form": form, "formset": formset, "title": "\u1056?\u1077?\u1076?\u1072?\u1082?\u1090?\u1080?\u1088?\u1086?\u1074?\u1072?\u1085?\u1080?\u1077? \u1079?\u1072?\u1082?\u1072?\u1079?\u1072?", "warnings": warnings, "info": info, "clients": clients, "dish_prices": dish_prices\},\par
                )\par
                item.save()\par
            for deleted in formset.deleted_objects:\par
                deleted.delete()\par
            _reserve_resources(order)\par
            if order.status in [OrderStatus.CONFIRMED, OrderStatus.READY_TO_SHIP, OrderStatus.SHIPPED] and not order.deliveries.exists():\par
                Delivery.objects.create(\par
                    order=order,\par
                    address=order.address,\par
