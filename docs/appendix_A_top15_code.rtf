@role_required("\u1052?\u1077?\u1085?\u1077?\u1076?\u1078?\u1077?\u1088?")\par
def proof_review_update(request, pk):\par
    stop = get_object_or_404(RouteStop, pk=pk)\par
    action = request.POST.get("action")\par
    comment = request.POST.get("comment", "")\par
    if action not in ["approve", "reject"]:\par
        return HttpResponseBadRequest("\u1053?\u1077?\u1082?\u1086?\u1088?\u1088?\u1077?\u1082?\u1090?\u1085?\u1086?\u1077? \u1076?\u1077?\u1081?\u1089?\u1090?\u1074?\u1080?\u1077?.")\par
    old_status = stop.proof_review_status\par
    stop.proof_review_status = (\par
        RouteStop.ProofReviewStatus.APPROVED if action == "approve" else RouteStop.ProofReviewStatus.REJECTED\par
    )\par
    stop.proof_review_comment = comment\par
    stop.proof_reviewed_at = timezone.now()\par
    stop.proof_reviewed_by = request.user\par
    stop.save(update_fields=["proof_review_status", "proof_review_comment", "proof_reviewed_at", "proof_reviewed_by"])\par
    _log_action(request.user, stop, "proof_review_status", old_status, stop.proof_review_status, comment)\par
    messages.success(request, "\u1055?\u1088?\u1086?\u1074?\u1077?\u1088?\u1082?\u1072? \u1086?\u1073?\u1085?\u1086?\u1074?\u1083?\u1077?\u1085?\u1072?.")\par
    return redirect("/logistics/manager/proofs/")\par
