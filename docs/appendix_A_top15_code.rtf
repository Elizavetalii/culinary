#!/usr/bin/env python3\par
import os\par
import sys\par
\par
\par
def main():\par
    os.environ.setdefault('DJANGO_SETTINGS_MODULE', 'factory_crm.settings')\par
    try:\par
        from django.core.management import execute_from_command_line\par
    except ImportError as exc:\par
        raise ImportError(\par
            "Couldn't import Django. Make sure it is installed and available on your PYTHONPATH."\par
        ) from exc\par
    execute_from_command_line(sys.argv)\par
\par
\par
if __name__ == '__main__':\par
    main()\par
