def dashboard_root(request):\par
    # \u1088?\u1077?\u1076?\u1080?\u1088?\u1077?\u1082?\u1090? \u1085?\u1072? \u1089?\u1086?\u1086?\u1090?\u1074?\u1077?\u1090?\u1089?\u1090?\u1074?\u1091?\u1102?\u1097?\u1091?\u1102? \u1088?\u1086?\u1083?\u1100?\par
