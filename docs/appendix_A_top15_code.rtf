@role_required("\u1050?\u1091?\u1088?\u1100?\u1077?\u1088?")\par
def courier_stop_update(request, pk):\par
    courier, _ = _get_or_create_courier_profile(request.user)\par
    stop = get_object_or_404(RouteStop, pk=pk)\par
    if not CourierAssignment.objects.filter(route=stop.route, courier=courier).exists():\par
        return HttpResponseBadRequest("\u1054?\u1089?\u1090?\u1072?\u1085?\u1086?\u1074?\u1082?\u1072? \u1085?\u1077?\u1076?\u1086?\u1089?\u1090?\u1091?\u1087?\u1085?\u1072?.")\par
    form = CourierStopStatusForm(request.POST, instance=stop)\par
    if request.method == "POST" and form.is_valid():\par
        new_status = form.cleaned_data["status"]\par
        if stop.status not in [RouteStop.StopStatus.IN_PROGRESS, RouteStop.StopStatus.PLANNED]:\par
            return HttpResponseBadRequest("\u1053?\u1077?\u1083?\u1100?\u1079?\u1103? \u1080?\u1079?\u1084?\u1077?\u1085?\u1080?\u1090?\u1100? \u1089?\u1090?\u1072?\u1090?\u1091?\u1089? \u1101?\u1090?\u1086?\u1081? \u1086?\u1089?\u1090?\u1072?\u1085?\u1086?\u1074?\u1082?\u1080?.")\par
        if new_status == RouteStop.StopStatus.IN_PROGRESS and stop.route.status not in [\par
            RouteStatus.PUBLISHED,\par
            RouteStatus.IN_PROGRESS,\par
        ]:\par
            return HttpResponseBadRequest("\u1052?\u1072?\u1088?\u1096?\u1088?\u1091?\u1090? \u1077?\u1097?\u1105? \u1085?\u1077? \u1086?\u1087?\u1091?\u1073?\u1083?\u1080?\u1082?\u1086?\u1074?\u1072?\u1085?.")\par
        if new_status == RouteStop.StopStatus.DONE:\par
            if not stop.proof_of_delivery:\par
                return HttpResponseBadRequest("\u1044?\u1086?\u1082?\u1091?\u1084?\u1077?\u1085?\u1090? \u1076?\u1086?\u1089?\u1090?\u1072?\u1074?\u1082?\u1080? \u1086?\u1073?\u1103?\u1079?\u1072?\u1090?\u1077?\u1083?\u1077?\u1085?.")\par
        if new_status == RouteStop.StopStatus.FAILED and not form.cleaned_data.get("failure_reason"):\par
            return HttpResponseBadRequest("\u1059?\u1082?\u1072?\u1078?\u1080?\u1090?\u1077? \u1087?\u1088?\u1080?\u1095?\u1080?\u1085?\u1091? \u1085?\u1077?\u1076?\u1086?\u1089?\u1090?\u1072?\u1074?\u1082?\u1080?.")\par
        old_status = stop.status\par
        stop = form.save(commit=False)\par
        if new_status in [RouteStop.StopStatus.DONE, RouteStop.StopStatus.FAILED]:\par
            stop.actual_time = timezone.now()\par
        stop.save()\par
        if new_status == RouteStop.StopStatus.IN_PROGRESS and stop.route.status == RouteStatus.PUBLISHED:\par
            stop.route.status = RouteStatus.IN_PROGRESS\par
            stop.route.save(update_fields=["status"])\par
        if new_status in [RouteStop.StopStatus.DONE, RouteStop.StopStatus.FAILED]:\par
            remaining = RouteStop.objects.filter(\par
                route=stop.route,\par
                status__in=[\par
                    RouteStop.StopStatus.DRAFT,\par
                    RouteStop.StopStatus.CONFIRMED,\par
                    RouteStop.StopStatus.PLANNED,\par
                    RouteStop.StopStatus.IN_PROGRESS,\par
                ],\par
            ).exists()\par
            if not remaining:\par
                stop.route.status = RouteStatus.DONE\par
                stop.route.save(update_fields=["status"])\par
        _log_action(request.user, stop, "status", old_status, new_status)\par
        messages.success(request, "\u1057?\u1090?\u1072?\u1090?\u1091?\u1089? \u1086?\u1089?\u1090?\u1072?\u1085?\u1086?\u1074?\u1082?\u1080? \u1086?\u1073?\u1085?\u1086?\u1074?\u1083?\u1105?\u1085?.")\par
    return redirect(f"/courier/routes/\{stop.route.id\}/")\par
\par
