            interaction_form = InteractionForm(request.POST, prefix="interaction")\par
            if interaction_form.is_valid():\par
                obj = interaction_form.save(commit=False)\par
                obj.client = client\par
                obj.manager = request.user\par
                obj.save()\par
                messages.success(request, "\u1042?\u1079?\u1072?\u1080?\u1084?\u1086?\u1076?\u1077?\u1081?\u1089?\u1090?\u1074?\u1080?\u1077? \u1076?\u1086?\u1073?\u1072?\u1074?\u1083?\u1077?\u1085?\u1086?.")\par
                return redirect(f"/clients/\{client.id\}/")\par
        if action == "change_stage":\par
            stage_form = StageChangeForm(request.POST, prefix="stage")\par
            if stage_form.is_valid():\par
                stage = stage_form.cleaned_data["stage"]\par
                comment = stage_form.cleaned_data.get("comment", "")\par
                ClientStageHistory.objects.create(\par
                    client=client,\par
                    stage=stage,\par
                    changed_by=request.user,\par
                    comment=comment,\par
                )\par
                client.current_stage = stage\par
                client.save(update_fields=["current_stage"])\par
                messages.success(request, "\u1069?\u1090?\u1072?\u1087? \u1089?\u1086?\u1090?\u1088?\u1091?\u1076?\u1085?\u1080?\u1095?\u1077?\u1089?\u1090?\u1074?\u1072? \u1086?\u1073?\u1085?\u1086?\u1074?\u1083?\u1105?\u1085?.")\par
                return redirect(f"/clients/\{client.id\}/")\par
\par
    return render(\par
        request,\par
        "clients/detail.html",\par
        \{\par
            "client": client,\par
            "interactions": interactions,\par
            "stage_history": stage_history,\par
            "client_orders": client_orders,\par
            "interaction_form": interaction_form,\par
            "stage_form": stage_form,\par
        \},\par
    )\par
