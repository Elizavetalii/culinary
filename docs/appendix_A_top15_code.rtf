from django.shortcuts import render, redirect, get_object_or_404\par
from django.db.models import Sum, Count\par
from django.db.models.functions import TruncDate\par
from django.utils import timezone\par
from accounts.utils import roles_required\par
from .models import Report\par
from .forms import ReportForm\par
from crm.models import Order, OrderStatus, Client\par
