@role_required("\u1051?\u1086?\u1075?\u1080?\u1089?\u1090?")\par
def route_detail(request, pk):\par
    route = get_object_or_404(Route, pk=pk)\par
    stops = RouteStop.objects.filter(route=route).select_related("delivery", "delivery__order")\par
    assignments = CourierAssignment.objects.filter(route=route).select_related("courier", "courier__user")\par
\par
    stop_form = RouteStopForm(prefix="stop")\par
    stop_form.fields["delivery"].queryset = Delivery.objects.exclude(route_stops__route=route)\par
    assign_form = CourierAssignmentForm(prefix="assign")\par
    assign_form.fields["courier"].queryset = Courier.objects.exclude(assignments__route=route)\par
\par
    if request.method == "POST":\par
        action = request.POST.get("action")\par
        if action == "add_stop":\par
            stop_form = RouteStopForm(request.POST, prefix="stop")\par
            stop_form.fields["delivery"].queryset = Delivery.objects.exclude(route_stops__route=route)\par
            delivery_id = request.POST.get("stop-delivery")\par
            if delivery_id:\par
                delivery = get_object_or_404(Delivery, pk=delivery_id)\par
                delivery_date = delivery.delivery_date or (delivery.planned_at.date() if delivery.planned_at else None)\par
                if not delivery_date:\par
                    return HttpResponseBadRequest("\u1059? \u1076?\u1086?\u1089?\u1090?\u1072?\u1074?\u1082?\u1080? \u1085?\u1077? \u1079?\u1072?\u1076?\u1072?\u1085?\u1072? \u1076?\u1072?\u1090?\u1072?.")\par
                if delivery_date != route.planned_date:\par
                    return HttpResponseBadRequest("\u1053?\u1077?\u1083?\u1100?\u1079?\u1103? \u1076?\u1086?\u1073?\u1072?\u1074?\u1080?\u1090?\u1100? \u1090?\u1086?\u1095?\u1082?\u1091? \u1076?\u1088?\u1091?\u1075?\u1086?\u1081? \u1076?\u1072?\u1090?\u1099? \u1076?\u1086?\u1089?\u1090?\u1072?\u1074?\u1082?\u1080?.")\par
            if stop_form.is_valid():\par
                obj = stop_form.save(commit=False)\par
                obj.route = route\par
                last = RouteStop.objects.filter(route=route).order_by("-sequence_index").first()\par
                obj.sequence_index = (last.sequence_index + 1) if last else 1\par
                obj.save()\par
                _normalize_route_stop_sequence(route)\par
                _log_action(request.user, route, "stops", "", f"\u1044?\u1086?\u1073?\u1072?\u1074?\u1083?\u1077?\u1085?\u1072? \u1086?\u1089?\u1090?\u1072?\u1085?\u1086?\u1074?\u1082?\u1072? \{obj.id\}")\par
                messages.success(request, "\u1054?\u1089?\u1090?\u1072?\u1085?\u1086?\u1074?\u1082?\u1072? \u1076?\u1086?\u1073?\u1072?\u1074?\u1083?\u1077?\u1085?\u1072?.")\par
                return redirect(f"/logistics/routes/\{route.id\}/")\par
        if action == "assign_courier":\par
            assign_form = CourierAssignmentForm(request.POST, prefix="assign")\par
            assign_form.fields["courier"].queryset = Courier.objects.exclude(assignments__route=route)\par
            if assign_form.is_valid():\par
                obj = assign_form.save(commit=False)\par
                obj.route = route\par
                obj.save()\par
                _log_action(request.user, route, "courier", "", obj.courier_id)\par
                messages.success(request, "\u1050?\u1091?\u1088?\u1100?\u1077?\u1088? \u1085?\u1072?\u1079?\u1085?\u1072?\u1095?\u1077?\u1085?.")\par
                return redirect(f"/logistics/routes/\{route.id\}/")\par
        if action in ["move_up", "move_down"]:\par
            stop_id = request.POST.get("stop_id")\par
            stop = get_object_or_404(RouteStop, pk=stop_id, route=route)\par
            delta = -1 if action == "move_up" else 1\par
            target = RouteStop.objects.filter(route=route, sequence_index=stop.sequence_index + delta).first()\par
            if target:\par
                RouteStop.objects.filter(pk=stop.pk).update(sequence_index=target.sequence_index)\par
                RouteStop.objects.filter(pk=target.pk).update(sequence_index=stop.sequence_index)\par
                _normalize_route_stop_sequence(route)\par
                _log_action(request.user, route, "sequence", "", "reorder")\par
                messages.success(request, "\u1055?\u1086?\u1088?\u1103?\u1076?\u1086?\u1082? \u1086?\u1089?\u1090?\u1072?\u1085?\u1086?\u1074?\u1086?\u1082? \u1086?\u1073?\u1085?\u1086?\u1074?\u1083?\u1105?\u1085?.")\par
            return redirect(f"/logistics/routes/\{route.id\}/")\par
        if action == "remove_stop":\par
            stop_id = request.POST.get("stop_id")\par
            reason = request.POST.get("reason", "")\par
            stop = get_object_or_404(RouteStop, pk=stop_id, route=route)\par
            old_status = stop.status\par
            stop.status = RouteStop.StopStatus.CANCELLED\par
            stop.save(update_fields=["status"])\par
            _normalize_route_stop_sequence(route)\par
            _log_action(request.user, stop, "status", old_status, stop.status, reason or "\u1059?\u1076?\u1072?\u1083?\u1077?\u1085?\u1072? \u1080?\u1079? \u1084?\u1072?\u1088?\u1096?\u1088?\u1091?\u1090?\u1072?")\par
            messages.success(request, "\u1054?\u1089?\u1090?\u1072?\u1085?\u1086?\u1074?\u1082?\u1072? \u1091?\u1076?\u1072?\u1083?\u1077?\u1085?\u1072? \u1080?\u1079? \u1084?\u1072?\u1088?\u1096?\u1088?\u1091?\u1090?\u1072?.")\par
            return redirect(f"/logistics/routes/\{route.id\}/")\par
        if action == "publish_route":\par
            metrics, errors, warnings = _route_validation(route)\par
            if errors:\par
                return HttpResponseBadRequest("; ".join(errors))\par
            old_status = route.status\par
            route.status = RouteStatus.PUBLISHED\par
            route.save(update_fields=["status"])\par
            RouteStop.objects.filter(route=route, status__in=[RouteStop.StopStatus.DRAFT, RouteStop.StopStatus.CONFIRMED]).update(\par
                status=RouteStop.StopStatus.PLANNED\par
            )\par
            _log_action(request.user, route, "status", old_status, route.status, "\u1055?\u1091?\u1073?\u1083?\u1080?\u1082?\u1072?\u1094?\u1080?\u1103? \u1084?\u1072?\u1088?\u1096?\u1088?\u1091?\u1090?\u1072?")\par
            messages.success(request, "\u1052?\u1072?\u1088?\u1096?\u1088?\u1091?\u1090? \u1086?\u1087?\u1091?\u1073?\u1083?\u1080?\u1082?\u1086?\u1074?\u1072?\u1085?.")\par
            return redirect(f"/logistics/routes/\{route.id\}/")\par
\par
    stop_points = []\par
    for s in stops:\par
        address = s.delivery.address or s.delivery.order.address\par
        stop_points.append(\par
            \{\par
                "id": s.id,\par
                "sequence": s.sequence_index,\par
                "status": s.status,\par
                "address": address,\par
                "lat": float(s.latitude) if s.latitude is not None else None,\par
                "lng": float(s.longitude) if s.longitude is not None else None,\par
            \}\par
        )\par
    map_payload = \{"route_id": route.id, "stops": stop_points\}\par
    profile, _ = LogisticianProfile.objects.get_or_create(user=request.user)\par
    metrics, errors, warnings = _route_validation(route)\par
    if not errors and route.status == RouteStatus.DRAFT:\par
        old_status = route.status\par
        route.status = RouteStatus.PLANNED\par
        route.save(update_fields=["status"])\par
        _log_action(request.user, route, "status", old_status, route.status, "\u1040?\u1074?\u1090?\u1086?-\u1087?\u1077?\u1088?\u1077?\u1093?\u1086?\u1076? \u1087?\u1088?\u1080? \u1074?\u1072?\u1083?\u1080?\u1076?\u1085?\u1086?\u1089?\u1090?\u1080?")\par
\par
    return render(\par
        request,\par
        "logistics/route_detail.html",\par
        \{\par
            "route": route,\par
            "stops": stops,\par
            "assignments": assignments,\par
            "stop_form": stop_form,\par
            "assign_form": assign_form,\par
            "map_payload": map_payload,\par
            "map_prefs": profile,\par
            "total_points": metrics["total_stops"],\par
            "total_weight": metrics["total_weight"],\par
            "total_volume": metrics["total_volume"],\par
            "route_distance_km": metrics["distance_km"],\par
            "route_duration_minutes": metrics["duration_minutes"],\par
            "route_errors": errors,\par
            "route_warnings": warnings,\par
        \},\par
    )\par
\par
