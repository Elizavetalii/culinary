def picker_order_detail(request, pk):\par
    order = get_object_or_404(Order, pk=pk)\par
    items_qs = order.items.all()\par
    session, _ = PickingSession.objects.get_or_create(order=order, defaults=\{"picker": request.user\})\par
    if not session.started_at:\par
        session.started_at = timezone.now()\par
        session.picker = request.user\par
        session.save(update_fields=["started_at", "picker"])\par
\par
    formset = OrderItemPickFormSet(request.POST or None, queryset=items_qs)\par
    session_form = PickingSessionForm(request.POST or None, instance=session, prefix="session")\par
\par
    if request.method == "POST":\par
        action = request.POST.get("action", "save")\par
        if formset.is_valid() and session_form.is_valid():\par
            formset.save()\par
            session_form.save()\par
\par
            if action == "finish":\par
                final_statuses = \{\par
                    OrderItem.ItemStatus.DONE,\par
                    OrderItem.ItemStatus.OUT_OF_STOCK,\par
                    OrderItem.ItemStatus.REPLACED,\par
                \}\par
                if items_qs.exclude(item_status__in=final_statuses).exists():\par
                    messages.error(request, "\u1053?\u1077? \u1074?\u1089?\u1077? \u1087?\u1086?\u1079?\u1080?\u1094?\u1080?\u1080? \u1080?\u1084?\u1077?\u1102?\u1090? \u1080?\u1090?\u1086?\u1075?\u1086?\u1074?\u1099?\u1081? \u1089?\u1090?\u1072?\u1090?\u1091?\u1089?.")\par
                else:\par
                    order.status = OrderStatus.SHIPPED\par
                    order.save(update_fields=["status"])\par
                    session.finished_at = timezone.now()\par
                    session.save(update_fields=["finished_at"])\par
                    if not order.deliveries.exists():\par
                        Delivery.objects.create(\par
                            order=order,\par
                            address=order.address,\par
                            status=Delivery.DeliveryStatus.UNASSIGNED,\par
                        )\par
                    messages.success(request, "\u1057?\u1073?\u1086?\u1088?\u1082?\u1072? \u1079?\u1072?\u1074?\u1077?\u1088?\u1096?\u1077?\u1085?\u1072?. \u1047?\u1072?\u1082?\u1072?\u1079? \u1087?\u1077?\u1088?\u1077?\u1076?\u1072?\u1085? \u1074? \u1076?\u1086?\u1089?\u1090?\u1072?\u1074?\u1082?\u1091?.")\par
            else:\par
                messages.success(request, "\u1048?\u1079?\u1084?\u1077?\u1085?\u1077?\u1085?\u1080?\u1103? \u1089?\u1086?\u1093?\u1088?\u1072?\u1085?\u1077?\u1085?\u1099?.")\par
        else:\par
            messages.error(request, "\u1055?\u1088?\u1086?\u1074?\u1077?\u1088?\u1100?\u1090?\u1077? \u1076?\u1072?\u1085?\u1085?\u1099?\u1077?: \u1077?\u1089?\u1090?\u1100? \u1086?\u1096?\u1080?\u1073?\u1082?\u1080? \u1074? \u1087?\u1086?\u1079?\u1080?\u1094?\u1080?\u1103?\u1093?.")\par
\par
    return render(\par
        request,\par
        "orders/picker_detail.html",\par
        \{\par
            "order": order,\par
            "formset": formset,\par
            "session_form": session_form,\par
            "session": session,\par
        \},\par
    )\par
