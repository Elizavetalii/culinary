@roles_required(["\u1052?\u1077?\u1085?\u1077?\u1076?\u1078?\u1077?\u1088?", "\u1040?\u1076?\u1084?\u1080?\u1085?\u1080?\u1089?\u1090?\u1088?\u1072?\u1090?\u1086?\u1088? \u1089?\u1080?\u1089?\u1090?\u1077?\u1084?\u1099?"])\par
def report_create(request):\par
    initial = \{\}\par
    if request.method == "GET":\par
        if request.GET.get("from"):\par
            initial["period_from"] = request.GET.get("from")\par
        if request.GET.get("to"):\par
            initial["period_to"] = request.GET.get("to")\par
    form = ReportForm(request.POST or None, request.FILES or None, initial=initial)\par
    if request.method == "POST" and form.is_valid():\par
        obj = form.save(commit=False)\par
        obj.created_by = request.user\par
        obj.save()\par
        return redirect("/reports/")\par
    return render(request, "reports/form.html", \{"form": form, "title": "\u1057?\u1086?\u1079?\u1076?\u1072?\u1090?\u1100? \u1086?\u1090?\u1095?\u1105?\u1090?"\})\par
\par
\par
@roles_required(["\u1052?\u1077?\u1085?\u1077?\u1076?\u1078?\u1077?\u1088?", "\u1040?\u1076?\u1084?\u1080?\u1085?\u1080?\u1089?\u1090?\u1088?\u1072?\u1090?\u1086?\u1088? \u1089?\u1080?\u1089?\u1090?\u1077?\u1084?\u1099?"])\par
def report_edit(request, pk):\par
    obj = get_object_or_404(Report, pk=pk)\par
    form = ReportForm(request.POST or None, request.FILES or None, instance=obj)\par
    if request.method == "POST" and form.is_valid():\par
        form.save()\par
        return redirect("/reports/")\par
    return render(request, "reports/form.html", \{"form": form, "title": "\u1056?\u1077?\u1076?\u1072?\u1082?\u1090?\u1080?\u1088?\u1086?\u1074?\u1072?\u1090?\u1100? \u1086?\u1090?\u1095?\u1105?\u1090?"\})\par
\par
\par
@roles_required(["\u1052?\u1077?\u1085?\u1077?\u1076?\u1078?\u1077?\u1088?", "\u1040?\u1076?\u1084?\u1080?\u1085?\u1080?\u1089?\u1090?\u1088?\u1072?\u1090?\u1086?\u1088? \u1089?\u1080?\u1089?\u1090?\u1077?\u1084?\u1099?"])\par
def report_validate(request, pk):\par
    report = get_object_or_404(Report, pk=pk)\par
    if request.method == "POST":\par
        if report.period_from and report.period_to and report.period_from > report.period_to:\par
            report.validation_status = "error"\par
            report.validation_message = "\u1044?\u1072?\u1090?\u1072? \u1085?\u1072?\u1095?\u1072?\u1083?\u1072? \u1073?\u1086?\u1083?\u1100?\u1096?\u1077? \u1076?\u1072?\u1090?\u1099? \u1086?\u1082?\u1086?\u1085?\u1095?\u1072?\u1085?\u1080?\u1103?."\par
        elif not report.file:\par
            report.validation_status = "warn"\par
            report.validation_message = "\u1060?\u1072?\u1081?\u1083? \u1086?\u1090?\u1095?\u1105?\u1090?\u1072? \u1085?\u1077? \u1079?\u1072?\u1075?\u1088?\u1091?\u1078?\u1077?\u1085?."\par
        else:\par
            report.validation_status = "ok"\par
            report.validation_message = "\u1055?\u1088?\u1086?\u1074?\u1077?\u1088?\u1082?\u1072? \u1087?\u1088?\u1086?\u1081?\u1076?\u1077?\u1085?\u1072? \u1091?\u1089?\u1087?\u1077?\u1096?\u1085?\u1086?."\par
        report.save(update_fields=["validation_status", "validation_message"])\par
    return redirect("/reports/")\par
\par
\par
@roles_required(["\u1052?\u1077?\u1085?\u1077?\u1076?\u1078?\u1077?\u1088?", "\u1040?\u1076?\u1084?\u1080?\u1085?\u1080?\u1089?\u1090?\u1088?\u1072?\u1090?\u1086?\u1088? \u1089?\u1080?\u1089?\u1090?\u1077?\u1084?\u1099?"])\par
def analytics_view(request):\par
    date_from = request.GET.get("from")\par
    date_to = request.GET.get("to")\par
    status = request.GET.get("status")\par
    client_id = request.GET.get("client")\par
    qs = Order.objects.all()\par
    if date_from:\par
        qs = qs.filter(created_at__date__gte=date_from)\par
    if date_to:\par
        qs = qs.filter(created_at__date__lte=date_to)\par
    if status:\par
        qs = qs.filter(status=status)\par
    if client_id:\par
        qs = qs.filter(client_id=client_id)\par
    total_orders = qs.count()\par
    revenue = qs.aggregate(total=Sum("total_amount"))["total"] or 0\par
    avg_check = round((revenue / total_orders), 2) if total_orders else 0\par
    status_labels = dict(OrderStatus.choices)\par
    raw_status = list(qs.values("status").annotate(cnt=Count("id")))\par
    max_cnt = max([row["cnt"] for row in raw_status], default=0) or 1\par
    by_status = [\par
        \{\par
            "status": row["status"],\par
            "label": status_labels.get(row["status"], row["status"]),\par
            "cnt": row["cnt"],\par
            "percent": int((row["cnt"] / max_cnt) * 100),\par
        \}\par
        for row in raw_status\par
    ]\par
    by_day = (\par
        qs.annotate(day=TruncDate("created_at"))\par
        .values("day")\par
        .annotate(cnt=Count("id"), revenue=Sum("total_amount"))\par
        .order_by("day")\par
    )\par
    by_day = [\par
        \{\par
            "day": row["day"].strftime("%Y-%m-%d") if row["day"] else "",\par
            "cnt": row["cnt"],\par
            "revenue": float(row["revenue"] or 0),\par
        \}\par
        for row in by_day\par
    ]\par
    avg_check_by_day = [\par
        \{\par
            "day": row["day"],\par
            "avg_check": round((row["revenue"] / row["cnt"]), 2) if row["cnt"] else 0,\par
        \}\par
        for row in by_day\par
    ]\par
    by_client = (\par
        qs.values("client__name")\par
        .annotate(cnt=Count("id"), revenue=Sum("total_amount"))\par
        .order_by("-revenue")[:10]\par
    )\par
    by_client = [\par
        \{\par
            "client": row["client__name"] or "\u8212?",\par
            "cnt": row["cnt"],\par
            "revenue": float(row["revenue"] or 0),\par
        \}\par
        for row in by_client\par
    ]\par
    by_client_type = (\par
        qs.values("client__client_type")\par
        .annotate(cnt=Count("id"), revenue=Sum("total_amount"))\par
        .order_by("-cnt")\par
    )\par
    by_client_type = [\par
        \{\par
            "type": row["client__client_type"] or "\u8212?",\par
            "cnt": row["cnt"],\par
            "revenue": float(row["revenue"] or 0),\par
        \}\par
        for row in by_client_type\par
    ]\par
    clients = Client.objects.all()\par
    context = \{\par
        "total_orders": total_orders,\par
        "revenue": revenue,\par
        "avg_check": avg_check,\par
        "by_status": list(by_status),\par
        "by_day": by_day,\par
        "avg_check_by_day": avg_check_by_day,\par
        "by_client": by_client,\par
        "by_client_type": by_client_type,\par
        "today": timezone.now().date(),\par
        "clients": clients,\par
        "statuses": OrderStatus.choices,\par
    \}\par
    return render(request, "reports/analytics.html", context)\par
