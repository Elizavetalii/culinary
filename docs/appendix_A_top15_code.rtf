                )\par
            messages.success(request, "\u1047?\u1072?\u1082?\u1072?\u1079? \u1086?\u1073?\u1085?\u1086?\u1074?\u1083?\u1105?\u1085?.")\par
            return redirect("/orders/")\par
    clients = Client.objects.all()\par
