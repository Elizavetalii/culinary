\par
\par
class Role(models.Model):\par
    name = models.CharField(max_length=64, unique=True)\par
\par
    class Meta:\par
        verbose_name = '\u1056?\u1086?\u1083?\u1100?'\par
        verbose_name_plural = '\u1056?\u1086?\u1083?\u1080?'\par
\par
    def __str__(self):\par
        return self.name\par
\par
\par
class User(AbstractUser):\par
    email = models.EmailField('Email', unique=True)\par
    full_name = models.CharField('\u1060?\u1048?\u1054?', max_length=255)\par
    phone = models.CharField('\u1058?\u1077?\u1083?\u1077?\u1092?\u1086?\u1085?', max_length=32, blank=True)\par
    roles = models.ManyToManyField(Role, through='UserRole', related_name='users', blank=True)\par
\par
