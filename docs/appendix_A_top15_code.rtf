def _apply_production_fields(order):\par
    if not order.delivery_date or not order.delivery_time:\par
        return\par
    morning_cutoff = timezone.datetime.strptime(\par
        getattr(settings, "ORDER_MORNING_CUTOFF_TIME", "10:00"), "%H:%M"\par
    ).time()\par
    if order.delivery_time <= morning_cutoff:\par
        order.production_date = order.delivery_date - timezone.timedelta(days=1)\par
        order.production_shift = "\u1053?\u1086?\u1095?\u1085?\u1072?\u1103?"\par
        order.production_window_start = timezone.datetime.strptime(\par
            getattr(settings, "PRODUCTION_WINDOW_NIGHT_START", "22:00"), "%H:%M"\par
        ).time()\par
        order.production_window_end = timezone.datetime.strptime(\par
            getattr(settings, "PRODUCTION_WINDOW_NIGHT_END", "06:00"), "%H:%M"\par
        ).time()\par
    else:\par
        order.production_date = order.delivery_date\par
        order.production_shift = "\u1044?\u1085?\u1077?\u1074?\u1085?\u1072?\u1103?"\par
        order.production_window_start = timezone.datetime.strptime(\par
            getattr(settings, "PRODUCTION_WINDOW_DAY_START", "06:00"), "%H:%M"\par
        ).time()\par
        order.production_window_end = timezone.datetime.strptime(\par
            getattr(settings, "PRODUCTION_WINDOW_DAY_END", "18:00"), "%H:%M"\par
        ).time()\par
