def _haversine_km(lat1, lon1, lat2, lon2):\par
    r = 6371.0\par
    phi1 = math.radians(lat1)\par
    phi2 = math.radians(lat2)\par
    d_phi = math.radians(lat2 - lat1)\par
    d_lambda = math.radians(lon2 - lon1)\par
    a = math.sin(d_phi / 2) ** 2 + math.cos(phi1) * math.cos(phi2) * math.sin(d_lambda / 2) ** 2\par
    return 2 * r * math.atan2(math.sqrt(a), math.sqrt(1 - a))\par
