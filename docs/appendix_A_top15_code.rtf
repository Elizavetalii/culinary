@roles_required(["\u1052?\u1077?\u1085?\u1077?\u1076?\u1078?\u1077?\u1088?", "\u1040?\u1076?\u1084?\u1080?\u1085?\u1080?\u1089?\u1090?\u1088?\u1072?\u1090?\u1086?\u1088? \u1089?\u1080?\u1089?\u1090?\u1077?\u1084?\u1099?"])\par
def client_list(request):\par
    qs = Client.objects.select_related("current_stage", "responsible_manager").all()\par
    q = request.GET.get("q")\par
    status = request.GET.get("status")\par
    stage = request.GET.get("stage")\par
    sort = request.GET.get("sort")\par
    if q:\par
        qs = qs.filter(Q(name__icontains=q) | Q(phone__icontains=q) | Q(email__icontains=q))\par
    if status:\par
        qs = qs.filter(status=status)\par
    if stage:\par
        qs = qs.filter(current_stage_id=stage)\par
    if sort in ["name", "-name", "created_at", "-created_at"]:\par
        qs = qs.order_by(sort)\par
    stages = CooperationStage.objects.filter(is_active=True)\par
    return render(\par
        request,\par
        "clients/list.html",\par
        \{"clients": qs, "stages": stages, "status_choices": ClientStatus.choices\},\par
    )\par
