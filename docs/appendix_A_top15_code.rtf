@roles_required(["\u1052?\u1077?\u1085?\u1077?\u1076?\u1078?\u1077?\u1088?", "\u1040?\u1076?\u1084?\u1080?\u1085?\u1080?\u1089?\u1090?\u1088?\u1072?\u1090?\u1086?\u1088? \u1089?\u1080?\u1089?\u1090?\u1077?\u1084?\u1099?"])\par
def order_availability(request):\par
    delivery_date = request.GET.get("delivery_date")\par
    client_id = request.GET.get("client_id")\par
    order_id = request.GET.get("order_id")\par
    if not delivery_date:\par
        return HttpResponseBadRequest("delivery_date \u1086?\u1073?\u1103?\u1079?\u1072?\u1090?\u1077?\u1083?\u1077?\u1085?")\par
    max_capacity = getattr(settings, "PRODUCTION_MAX_WEIGHT_KG", None)\par
    reserved_map = _get_reserved_qty_map(delivery_date, exclude_order_id=order_id)\par
    reserved_capacity = ProductionReservation.objects.filter(production_date=delivery_date).aggregate(\par
        total=Sum("weight_kg")\par
    )["total"] or 0\par
    dishes = []\par
    for dish in Dish.objects.filter(is_active=True).order_by("name"):\par
        daily_capacity = float(dish.daily_capacity) if dish.daily_capacity is not None else None\par
        reserved_qty = float(reserved_map.get(dish.id, 0) or 0)\par
        available_qty = None\par
        if daily_capacity is not None:\par
            available_qty = max(daily_capacity - reserved_qty, 0)\par
        weight_per_unit = float(dish.unit_weight_kg) if dish.unit_weight_kg is not None else None\par
        max_by_capacity = None\par
        if max_capacity is not None:\par
            if dish.base_uom == Dish.BaseUom.KG:\par
                max_by_capacity = max_capacity - reserved_capacity\par
            elif dish.base_uom == Dish.BaseUom.PCS and weight_per_unit:\par
                max_by_capacity = (max_capacity - reserved_capacity) / weight_per_unit\par
        dishes.append(\par
            \{\par
                "dish_id": dish.id,\par
                "dish_name": dish.name,\par
                "unit": dish.unit,\par
                "base_uom": dish.base_uom,\par
                "quantity_scale": dish.quantity_scale,\par
                "weight_per_unit_kg": weight_per_unit,\par
                "daily_capacity": daily_capacity,\par
                "reserved_qty": round(reserved_qty, 3),\par
                "available_qty": round(available_qty, 3) if available_qty is not None else None,\par
                "max_by_capacity": round(max_by_capacity, 3) if max_by_capacity is not None else None,\par
                "min_batch": float(dish.min_batch_qty) if dish.min_batch_qty else None,\par
                "step": float(dish.batch_multiple_qty) if dish.batch_multiple_qty else None,\par
                "price": float(dish.default_price) if dish.default_price is not None else None,\par
            \}\par
        )\par
    return JsonResponse(\par
        \{\par
            "production_date": delivery_date,\par
            "capacity_total": max_capacity if max_capacity is not None else 0,\par
            "capacity_reserved": reserved_capacity,\par
            "capacity_available": max_capacity - reserved_capacity if max_capacity is not None else 0,\par
            "dishes": dishes,\par
        \}\par
    )\par
