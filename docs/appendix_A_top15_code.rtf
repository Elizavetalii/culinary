            "item_comment": "\u1050?\u1086?\u1084?\u1084?\u1077?\u1085?\u1090?\u1072?\u1088?\u1080?\u1081?",\par
        \}\par
\par
    def __init__(self, *args, **kwargs):\par
        super().__init__(*args, **kwargs)\par
        self._init_bootstrap()\par
        if "dish" in self.fields:\par
            self.fields["dish"].queryset = Dish.objects.filter(is_active=True).order_by("name")\par
        if "unit_price" in self.fields:\par
            self.fields["unit_price"].widget.attrs.setdefault("readonly", True)\par
            self.fields["unit_price"].widget.attrs.setdefault("inputmode", "decimal")\par
            self.fields["unit_price"].widget.attrs.setdefault("step", "0.01")\par
        if "quantity" in self.fields:\par
            self.fields["quantity"].widget.attrs.setdefault("min", "1")\par
            self.fields["quantity"].widget.attrs.setdefault("step", "1")\par
\par
    def clean(self):\par
        cleaned = super().clean()\par
        dish = cleaned.get("dish")\par
        qty = cleaned.get("quantity")\par
        if not dish:\par
            self.add_error("dish", "\u1042?\u1099?\u1073?\u1077?\u1088?\u1080?\u1090?\u1077? \u1073?\u1083?\u1102?\u1076?\u1086?.")\par
        if qty is not None:\par
            if qty <= 0:\par
                self.add_error("quantity", "\u1050?\u1086?\u1083?\u1080?\u1095?\u1077?\u1089?\u1090?\u1074?\u1086? \u1076?\u1086?\u1083?\u1078?\u1085?\u1086? \u1073?\u1099?\u1090?\u1100? \u1073?\u1086?\u1083?\u1100?\u1096?\u1077? 0.")\par
            if dish:\par
                scale = dish.quantity_scale or 0\par
                quant = Decimal("1").scaleb(-scale)\par
                try:\par
                    quantized = Decimal(qty).quantize(quant)\par
                except (InvalidOperation, TypeError):\par
                    self.add_error("quantity", "\u1053?\u1077?\u1082?\u1086?\u1088?\u1088?\u1077?\u1082?\u1090?\u1085?\u1099?\u1081? \u1092?\u1086?\u1088?\u1084?\u1072?\u1090? \u1082?\u1086?\u1083?\u1080?\u1095?\u1077?\u1089?\u1090?\u1074?\u1072?.")\par
                    return cleaned\par
                if quantized != Decimal(qty):\par
                    self.add_error("quantity", f"\u1050?\u1086?\u1083?\u1080?\u1095?\u1077?\u1089?\u1090?\u1074?\u1086? \u1076?\u1086?\u1083?\u1078?\u1085?\u1086? \u1080?\u1084?\u1077?\u1090?\u1100? \u1085?\u1077? \u1073?\u1086?\u1083?\u1077?\u1077? \{scale\} \u1079?\u1085?\u1072?\u1082?\u1086?\u1074? \u1087?\u1086?\u1089?\u1083?\u1077? \u1079?\u1072?\u1087?\u1103?\u1090?\u1086?\u1081?.")\par
                if dish.base_uom == Dish.BaseUom.PCS and quantized != quantized.to_integral_value():\par
                    self.add_error("quantity", "\u1044?\u1083?\u1103? \u1096?\u1090?\u1091?\u1095?\u1085?\u1099?\u1093? \u1073?\u1083?\u1102?\u1076? \u1082?\u1086?\u1083?\u1080?\u1095?\u1077?\u1089?\u1090?\u1074?\u1086? \u1076?\u1086?\u1083?\u1078?\u1085?\u1086? \u1073?\u1099?\u1090?\u1100? \u1094?\u1077?\u1083?\u1099?\u1084?.")\par
                if dish.min_batch_qty is not None and quantized < dish.min_batch_qty:\par
                    self.add_error("quantity", f"\u1052?\u1080?\u1085?\u1080?\u1084?\u1072?\u1083?\u1100?\u1085?\u1072?\u1103? \u1087?\u1072?\u1088?\u1090?\u1080?\u1103?: \{dish.min_batch_qty\}.")\par
                if dish.batch_multiple_qty:\par
                    step = dish.batch_multiple_qty\par
                    remainder = (quantized % step) if step else Decimal("0")\par
                    if remainder != 0:\par
                        self.add_error("quantity", f"\u1050?\u1086?\u1083?\u1080?\u1095?\u1077?\u1089?\u1090?\u1074?\u1086? \u1076?\u1086?\u1083?\u1078?\u1085?\u1086? \u1073?\u1099?\u1090?\u1100? \u1082?\u1088?\u1072?\u1090?\u1085?\u1086? \{step\}.")\par
        return cleaned\par
